# Copy to .dev.vars for local development (never commit .dev.vars)

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-me-openssl-rand-base64-48"

# Set to "1" to print magic-link sign-in URLs into the Worker log, so you can
# sign in locally without a working mail path. Never set this in production —
# the printed URL is a live credential for fifteen minutes.
AUTH_DEBUG="1"

# Stripe (optional). Leave blank to disable Stripe and use bank transfer only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (only needed when MAIL_PROVIDER=resend)
RESEND_API_KEY=""

# Google Places discovery (optional). Without it the growth pipeline uses
# OpenStreetMap, which needs no key. Places has broader coverage and carries
# ratings, but costs per request and its terms limit how long results may be
# cached.
GOOGLE_PLACES_API_KEY=""

# Only needed if each demo subdomain should get its own DNS record rather than
# being covered by a wildcard. The token needs Zone:DNS:Edit on that zone and
# nothing else. With a wildcard record in place, leave both blank.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Web search for checking how well known a business already is, so a
# recognised chain never ends up on a prospect list. The Wikidata lookup runs
# without any of this and catches most of them; a search provider adds press
# coverage on top. "brave" or "serper".
SEARCH_PROVIDER="none"
SEARCH_API_KEY=""
