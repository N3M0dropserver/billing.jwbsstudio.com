{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "billing-jwbsstudio-com",
    "compatibility_date": "2026-09-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    // `main` and `assets` are set by the Astro Cloudflare adapter's Vite
    // plugin at build time — do not add them here, it will fail the build.
    "observability": {
        "enabled": true
    },
    // Scheduled work. Cron Triggers invoke the Worker's scheduled() handler,
    // which the Astro adapter does not emit — scripts/wrap-worker.mjs adds it
    // at build time and maps each expression to a task. Keep these in step
    // with the SCHEDULE map in that script.
    //
    // Times are UTC. 08:00 UTC is 20:00/21:00 NZ and 18:00/19:00 AEST, so a
    // reminder is written overnight and lands first thing in the morning.
    // Nothing is sent until reminders are switched on in Settings AND
    // CRON_SECRET is set.
    "triggers": {
        "crons": [
            "0 8 * * *",
            "0 3 * * 7"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "jwbs-billing",
            "database_id": "da0a78d0-af29-4c41-ba3c-47ee983b6bdc",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "jwbs-billing-files"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "SESSION",
            "id": "f9558282d10a4562a48ae4e44d6d547b"
        }
    ],
    "ai": {
        "binding": "AI"
    },
    // The agents live in their own Worker (workers/agent) because the Astro
    // Cloudflare adapter generates this Worker's entry and there is no
    // supported way to add a Durable Object export to it.
    //
    // THAT WORKER MUST BE DEPLOYED FIRST. Cloudflare resolves `class_name`
    // against the *deployed* `jwbs-growth-agent`, so deploying this one
    // against a stale copy fails outright:
    //
    //   Cannot create binding for class 'ResearchAgent'
    //   that is not exported by script 'jwbs-growth-agent'  [code: 10061]
    //
    // `bun run deploy` does both in order. A CI deploy command that runs
    // `wrangler deploy` on its own skips the agent and hits the above the
    // first time a class is added — so point CI at `bun run deploy`, not at
    // wrangler directly.
    "durable_objects": {
        "bindings": [
            {
                "name": "CAMPAIGN_AGENT",
                "class_name": "CampaignAgent",
                "script_name": "jwbs-growth-agent"
            },
            {
                "name": "RESEARCH_AGENT",
                "class_name": "ResearchAgent",
                "script_name": "jwbs-growth-agent"
            }
        ]
    },
    "vars": {
        "APP_NAME": "JWBS Studio Billing",
        "APP_URL": "https://billing.jwbsstudio.com",
        // "cloudflare" uses the EMAIL binding below (Cloudflare Email Service,
        // public beta). "resend" uses RESEND_API_KEY. "none" disables sending.
        "MAIL_PROVIDER": "cloudflare",
        "MAIL_FROM": "invoices@jwbsstudio.com",
        "MAIL_FROM_NAME": "JWBS Studio",
        // Generated demo sites are served from this Worker. `*` is where the
        // business's label goes, and the value is written the same way as the
        // Worker route. A suffix pattern keeps each demo one label below the
        // apex, which is as deep as Cloudflare's free Universal SSL reaches,
        // while a route of `*-demo.…` cannot match `www`.
        //
        //   *.jwbsstudio.com  CNAME  billing.jwbsstudio.com  (proxied)
        //   route: *-demo.jwbsstudio.com/*
        //
        // The DNS wildcard is necessarily broader than the route — a wildcard
        // record is a whole label — but explicit records win over it, so the
        // rest of the zone is unaffected. See README.
        "DEMO_HOST": "*-demo.jwbsstudio.com"
    },
    // Cloudflare Email Service. The sending domain must use Cloudflare DNS and
    // be onboarded to Email Service before this can reach arbitrary recipients
    // — until then it delivers only to destination addresses verified in your
    // account. See README.
    //
    // `remote: true` lets `wrangler dev` send through the real service while the
    // Worker runs locally; there is no local emulation of email delivery.
    "send_email": [
        {
            "name": "EMAIL",
            "remote": true
        }
    ]
}
