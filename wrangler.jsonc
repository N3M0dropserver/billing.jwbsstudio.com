{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "billing-jwbsstudio-com",
    "compatibility_date": "2026-09-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    // `main` and `assets` are set by the Astro Cloudflare adapter's Vite
    // plugin at build time — do not add them here, it will fail the build.
    "observability": {
        "enabled": true
    },
    // Scheduled work. Cron Triggers invoke the Worker's scheduled() handler,
    // which the Astro adapter does not emit — scripts/wrap-worker.mjs adds it
    // at build time and maps each expression to a task. Keep these in step
    // with the SCHEDULE map in that script.
    //
    // Times are UTC. 08:00 UTC is 20:00/21:00 NZ and 18:00/19:00 AEST, so a
    // reminder is written overnight and lands first thing in the morning.
    // Nothing is sent until reminders are switched on in Settings AND
    // CRON_SECRET is set.
    "triggers": {
        "crons": [
            "0 8 * * *",
            "0 3 * * 0"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "jwbs-billing",
            "database_id": "da0a78d0-af29-4c41-ba3c-47ee983b6bdc",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "jwbs-billing-files"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "SESSION",
            "id": "f9558282d10a4562a48ae4e44d6d547b"
        }
    ],
    "ai": {
        "binding": "AI"
    },
    "vars": {
        "APP_NAME": "JWBS Studio Billing",
        "APP_URL": "https://billing.jwbsstudio.com",
        // "cloudflare" uses the EMAIL binding below (Cloudflare Email Service,
        // public beta). "resend" uses RESEND_API_KEY. "none" disables sending.
        "MAIL_PROVIDER": "cloudflare",
        "MAIL_FROM": "invoices@jwbsstudio.com",
        "MAIL_FROM_NAME": "JWBS Studio"
    },
    // Cloudflare Email Service. The sending domain must use Cloudflare DNS and
    // be onboarded to Email Service before this can reach arbitrary recipients
    // — until then it delivers only to destination addresses verified in your
    // account. See README.
    //
    // `remote: true` lets `wrangler dev` send through the real service while the
    // Worker runs locally; there is no local emulation of email delivery.
    "send_email": [
        {
            "name": "EMAIL",
            "remote": true
        }
    ]
}
