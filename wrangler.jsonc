{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "billing-jwbsstudio-com",
    "compatibility_date": "2026-09-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    // `main` and `assets` are set by the Astro Cloudflare adapter's Vite
    // plugin at build time — do not add them here, it will fail the build.
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "jwbs-billing",
            "database_id": "da0a78d0-af29-4c41-ba3c-47ee983b6bdc",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "jwbs-billing-files"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "SESSION",
            "id": "f9558282d10a4562a48ae4e44d6d547b"
        }
    ],
    "ai": {
        "binding": "AI"
    },
    // The campaign agent lives in its own Worker (workers/agent) because the
    // Astro Cloudflare adapter generates this Worker's entry and there is no
    // supported way to add a Durable Object export to it. Deploy that Worker
    // first — `bun run deploy:agent`, or `bun run deploy` which does both.
    "durable_objects": {
        "bindings": [
            {
                "name": "CAMPAIGN_AGENT",
                "class_name": "CampaignAgent",
                "script_name": "jwbs-growth-agent"
            },
            {
                "name": "RESEARCH_AGENT",
                "class_name": "ResearchAgent",
                "script_name": "jwbs-growth-agent"
            }
        ]
    },
    "vars": {
        "APP_NAME": "JWBS Studio Billing",
        "APP_URL": "https://billing.jwbsstudio.com",
        // "cloudflare" uses the EMAIL binding below (Cloudflare Email Service,
        // public beta). "resend" uses RESEND_API_KEY. "none" disables sending.
        "MAIL_PROVIDER": "cloudflare",
        "MAIL_FROM": "invoices@jwbsstudio.com",
        "MAIL_FROM_NAME": "JWBS Studio",
        // Generated demo sites are served from this Worker on any subdomain
        // of this host. Point a proxied wildcard at the app and add a
        // matching Worker route:
        //   *.demo.jwbsstudio.com  CNAME  billing.jwbsstudio.com  (proxied)
        //   route: *.demo.jwbsstudio.com/*
        "DEMO_HOST": "demo.jwbsstudio.com"
    },
    // Cloudflare Email Service. The sending domain must use Cloudflare DNS and
    // be onboarded to Email Service before this can reach arbitrary recipients
    // — until then it delivers only to destination addresses verified in your
    // account. See README.
    //
    // `remote: true` lets `wrangler dev` send through the real service while the
    // Worker runs locally; there is no local emulation of email delivery.
    "send_email": [
        {
            "name": "EMAIL",
            "remote": true
        }
    ]
}
