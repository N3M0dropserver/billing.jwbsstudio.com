{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jwbs-billing",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // `main` and `assets` are set by the Astro Cloudflare adapter's Vite
  // plugin at build time — do not add them here, it will fail the build.

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jwbs-billing",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "jwbs-billing-files"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "APP_NAME": "JWBS Studio Billing",
    "APP_URL": "https://billing.jwbsstudio.com",
    // "cloudflare" uses the EMAIL binding below (Cloudflare Email Service,
    // public beta). "resend" uses RESEND_API_KEY. "none" disables sending.
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "invoices@jwbsstudio.com",
    "MAIL_FROM_NAME": "JWBS Studio"
  }

  // To send through Cloudflare Email Service instead of Resend, set
  // MAIL_PROVIDER to "cloudflare" and uncomment:
  //
  // "send_email": [{ "name": "EMAIL" }]
}
