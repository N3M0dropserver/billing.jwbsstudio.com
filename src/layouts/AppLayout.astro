---
import '~/styles/app.css';
import Sidebar from '~/components/nav/Sidebar.astro';
import TopBar from '~/components/nav/TopBar.astro';
import BottomTabs from '~/components/nav/BottomTabs.astro';
import OmniSearch from '~/components/search/OmniSearch.tsx';

interface Props {
  title: string;
  subtitle?: string;
  /** Wide pages (tables) get more room than forms. */
  width?: 'default' | 'wide' | 'narrow';
}

const { title, subtitle, width = 'default' } = Astro.props;
const user = Astro.locals.user;

const widths = {
  narrow: 'max-w-2xl',
  default: 'max-w-6xl',
  wide: 'max-w-[110rem]',
};
---

<!doctype html>
<html lang="en-NZ" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
    <title>{title} · JWBS Studio</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      try {
        const stored = localStorage.getItem('theme');
        if (stored) document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body class="h-full">
    <TopBar user={user} />

    <div class="flex min-h-full flex-col lg:flex-row">
      <Sidebar user={user} />

      <main class="min-w-0 flex-1">
        <div
          class={`mx-auto w-full px-4 pt-5 sm:px-6 lg:px-8 lg:py-8 ${widths[width]}`}
          style="padding-bottom: calc(6rem + env(safe-area-inset-bottom, 0px))"
        >
          <header class="mb-5 flex flex-wrap items-end justify-between gap-x-4 gap-y-3 lg:mb-6">
            <div class="min-w-0">
              <h1 class="truncate text-xl font-semibold tracking-tight sm:text-2xl">{title}</h1>
              {subtitle && <p class="label muted mt-1.5">{subtitle}</p>}
            </div>
            <slot name="actions" />
          </header>

          <slot />
        </div>
      </main>
    </div>

    <BottomTabs />

    <OmniSearch client:idle />

    <script is:inline>
      document.addEventListener('click', (e) => {
        const t = e.target;
        if (t instanceof Element && t.closest('[data-theme-toggle]')) {
          const root = document.documentElement;
          const isDark =
            root.dataset.theme === 'dark' ||
            (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
          const next = isDark ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          // Keep the browser chrome in step with the page.
          for (const tag of document.querySelectorAll('meta[name="theme-color"]')) {
            tag.remove();
          }
          const meta = document.createElement('meta');
          meta.name = 'theme-color';
          meta.content = next === 'dark' ? '#0f0f0f' : '#ffffff';
          document.head.appendChild(meta);
        }
      });
    </script>
  </body>
</html>
