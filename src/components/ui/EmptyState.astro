---
interface Props {
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
}
const { title, description, actionHref, actionLabel } = Astro.props;
---
<div class="card px-5 py-12 text-center sm:px-6">
  <p class="label">{title}</p>
  {description && <p class="muted mx-auto mt-2.5 max-w-sm text-sm leading-relaxed">{description}</p>}
  {
    actionHref && actionLabel && (
      <a href={actionHref} class="btn btn-primary mt-5">{actionLabel}</a>
    )
  }
</div>
