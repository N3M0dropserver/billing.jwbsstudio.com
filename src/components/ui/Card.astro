---
interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}
const { title, subtitle, class: className = '' } = Astro.props;
---
<section class:list={['card p-5', className]}>
  {
    (title || subtitle) && (
      <header class="mb-4 flex items-start justify-between gap-3">
        <div>
          {title && <h2 class="text-sm font-semibold">{title}</h2>}
          {subtitle && <p class="muted mt-0.5 text-xs">{subtitle}</p>}
        </div>
        <slot name="header-action" />
      </header>
    )
  }
  <slot />
</section>
