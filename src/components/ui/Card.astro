---
interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}
const { title, subtitle, class: className = '' } = Astro.props;
---
<section class:list={['card', className]}>
  {
    (title || subtitle) && (
      <header
        class="flex items-start justify-between gap-3 border-b px-4 py-3 sm:px-5"
        style="border-color: var(--border)"
      >
        <div class="min-w-0">
          {title && <h2 class="label">{title}</h2>}
          {subtitle && <p class="muted mt-1 text-xs leading-snug">{subtitle}</p>}
        </div>
        <slot name="header-action" />
      </header>
    )
  }
  <div class="p-4 sm:p-5">
    <slot />
  </div>
</section>
