---
interface Props {
  label: string;
  value: string;
  hint?: string;
  tone?: 'neutral' | 'paid' | 'owing' | 'overdue' | 'reserved';
  href?: string;
}
const { label, value, hint, tone = 'neutral', href } = Astro.props;

const tones: Record<string, string> = {
  neutral: 'var(--text)',
  paid: 'var(--color-paid)',
  owing: 'var(--color-owing)',
  overdue: 'var(--color-overdue)',
  reserved: 'var(--color-reserved)',
};
const Tag = href ? 'a' : 'div';
---
<Tag
  href={href}
  class:list={['card block px-3.5 py-3 sm:px-4', href && 'transition-colors hover:border-[var(--border-strong)]']}
>
  <p class="label muted">{label}</p>
  <p
    class="tabular mt-2 text-xl leading-tight font-semibold tracking-tight sm:text-2xl"
    style={`color: ${tones[tone]}`}
  >{value}</p>
  {hint && <p class="muted mt-1 text-xs leading-snug">{hint}</p>}
</Tag>
