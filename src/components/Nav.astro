---
import type { User } from '~/lib/db/schema';

interface Props {
  user: User | null;
}
const { user } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Dashboard', icon: 'grid' },
  { href: '/invoices', label: 'Invoices', icon: 'file' },
  { href: '/clients', label: 'Clients', icon: 'users' },
  { href: '/quotes', label: 'Quotes', icon: 'quote' },
  { href: '/time', label: 'Time', icon: 'clock' },
  { href: '/bank', label: 'Bank', icon: 'bank' },
  { href: '/tax', label: 'Tax & accounting', icon: 'calculator' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const icons: Record<string, string> = {
  grid: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  file: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M9 13h6M9 17h6',
  users: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  clock: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
  calculator: 'M4 2h16v20H4zM8 6h8M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M16 14h.01M8 18h8',
  bank: 'M3 21h18M3 10h18M5 6l7-3 7 3M6 10v11M10 10v11M14 10v11M18 10v11',
  quote: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2zM8 9h8M8 13h5',
};
---

<nav
  class="shrink-0 border-b lg:h-screen lg:w-60 lg:border-r lg:border-b-0 lg:sticky lg:top-0"
  style="background: var(--surface-raised); border-color: var(--border)"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between px-4 py-4 lg:px-5">
      <a href="/" class="flex items-center gap-2.5">
        <span
          class="grid size-8 place-items-center rounded-lg text-sm font-bold text-white"
          style="background: var(--color-brand-600)"
        >J</span>
        <span class="text-sm font-semibold tracking-tight">JWBS Studio</span>
      </a>
      <button
        type="button"
        data-theme-toggle
        class="muted rounded-md p-1.5 hover:opacity-70 lg:hidden"
        aria-label="Toggle theme"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>

    <div class="px-3 pb-3 lg:px-3">
      <button
        type="button"
        data-omni-open
        class="muted flex w-full items-center gap-2 rounded-lg border px-3 py-2 text-left text-sm hover:opacity-80"
        style="border-color: var(--border); background: var(--surface-sunken)"
      >
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" />
        </svg>
        <span class="flex-1">Search…</span>
        <kbd class="rounded border px-1.5 py-0.5 text-[10px]" style="border-color: var(--border)">⌘K</kbd>
      </button>
    </div>

    <ul class="flex gap-1 overflow-x-auto px-3 pb-3 lg:flex-col lg:overflow-visible lg:pb-0">
      {
        links.map((link) => (
          <li class="shrink-0 lg:shrink">
            <a
              href={link.href}
              class:list={[
                'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium transition-colors whitespace-nowrap',
                isActive(link.href) ? 'text-white' : 'muted hover:opacity-80',
              ]}
              style={isActive(link.href) ? 'background: var(--color-brand-600)' : ''}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[link.icon]} />
              </svg>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {/*
      Settings and Sign out used to be `hidden lg:block`, which meant that on
      a phone there was no way to sign out and no route to Settings at all —
      and Settings is where the business details every invoice depends on are
      entered. They are visible at every width now; only the account name and
      email, which need the room, wait for the sidebar.
    */}
    <div class="mt-auto border-t p-3" style="border-color: var(--border)">
      <div class="hidden items-center gap-2 lg:flex">
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium">{user?.name ?? 'Not signed in'}</p>
          <p class="muted truncate text-xs">{user?.email ?? ''}</p>
        </div>
        <button
          type="button"
          data-theme-toggle
          class="muted rounded-md p-1.5 hover:opacity-70"
          aria-label="Toggle theme"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </div>
      <div class="flex gap-2 lg:mt-2">
        <a href="/settings" class="muted flex-1 rounded-md border px-2 py-1.5 text-center text-xs hover:opacity-80" style="border-color: var(--border)">Settings</a>
        <form method="post" action="/api/auth/logout" class="flex-1">
          <button class="muted w-full rounded-md border px-2 py-1.5 text-xs hover:opacity-80" style="border-color: var(--border)">Sign out</button>
        </form>
      </div>
    </div>
  </div>
</nav>
