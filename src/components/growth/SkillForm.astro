---
/**
 * The edit form, shared by "new" and "edit".
 *
 * Match rules are the part people get wrong, so they are shown as what they
 * do — "only these trades", "only when they have no site" — rather than as
 * the JSON they are stored as.
 */
import { SKILL_STAGES, MAX_SKILL_LENGTH, type AgentSkill } from '~/lib/growth/skills';

interface Props {
  skill: AgentSkill | null;
  /** A draft the model wrote, not yet saved. */
  draftNote?: string;
}

const { skill, draftNote } = Astro.props as Props;

const value = skill ?? {
  slug: '',
  name: '',
  stage: 'plan' as const,
  summary: '',
  instructions: '',
  match: { niches: [], objectives: [], website: 'any' as const },
  enabled: true,
  builtIn: false,
};

const OBJECTIVES = ['conversion', 'awareness', 'credibility'] as const;
---

<form method="post" action="/api/growth-skills" class="space-y-4">
  <input type="hidden" name="action" value="save" />
  {value.slug && <input type="hidden" name="slug" value={value.slug} />}

  {draftNote && (
    <p class="muted rounded-lg px-4 py-3 text-sm leading-relaxed" style="background: var(--surface-sunken)" role="status">
      {draftNote}
    </p>
  )}

  <div class="grid gap-3.5 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-1.5 block text-sm font-medium">Name</label>
      <input id="name" name="name" value={value.name} required class="field" placeholder="Designing for somewhere people walk into" />
    </div>
    <div>
      <label for="stage" class="mb-1.5 block text-sm font-medium">Read at</label>
      <select id="stage" name="stage" class="field">
        {SKILL_STAGES.map((entry) => (
          <option value={entry.stage} selected={entry.stage === value.stage}>{entry.label}</option>
        ))}
      </select>
    </div>
  </div>

  <div>
    <label for="summary" class="mb-1.5 block text-sm font-medium">One line, for the list</label>
    <input id="summary" name="summary" value={value.summary} class="field" placeholder="Cafes and bars — the page has one job and it is not brand." />
  </div>

  <div>
    <label for="instructions" class="mb-1.5 block text-sm font-medium">The know-how</label>
    <textarea
      id="instructions"
      name="instructions"
      rows="16"
      maxlength={MAX_SKILL_LENGTH}
      required
      class="field font-mono text-xs leading-relaxed"
      spellcheck="false"
      placeholder="Say what to do, in specifics. Name the failure mode and what to write instead."
    >{value.instructions}</textarea>
    <p class="muted mt-1.5 text-xs leading-relaxed">
      This is appended to that stage's prompt, after the general instructions and before the
      shape the answer has to take. Direct guidance works; a description of good design does not.
    </p>
  </div>

  <fieldset class="rounded-lg border p-3.5" style="border-color: var(--border)">
    <legend class="px-1 text-sm font-medium">When it applies</legend>

    <div class="mt-1">
      <label for="niches" class="mb-1.5 block text-sm">Only these trades</label>
      <input
        id="niches"
        name="niches"
        value={value.match.niches.join(', ')}
        class="field"
        placeholder="cafe, coffee, bakery"
      />
      <p class="muted mt-1.5 text-xs leading-relaxed">
        Comma separated, matched inside the trade and the directory's category. Use the stem —
        <code>plumb</code> catches “plumber” and “plumbing”. Leave empty for every trade.
      </p>
    </div>

    <div class="mt-3.5">
      <p class="mb-1.5 text-sm">Only when the page's job is</p>
      <div class="flex flex-wrap gap-3">
        {OBJECTIVES.map((objective) => (
          <label class="flex items-center gap-2 text-sm">
            <input
              type="checkbox"
              name={`objective-${objective}`}
              value="yes"
              checked={value.match.objectives.includes(objective)}
            />
            {objective}
          </label>
        ))}
      </div>
      <p class="muted mt-1.5 text-xs">None ticked means all three.</p>
    </div>

    <div class="mt-3.5 max-w-xs">
      <label for="website" class="mb-1.5 block text-sm">Only when they</label>
      <select id="website" name="website" class="field">
        <option value="any" selected={value.match.website === 'any'}>Either way</option>
        <option value="with" selected={value.match.website === 'with'}>Already have a website</option>
        <option value="without" selected={value.match.website === 'without'}>Have no website</option>
      </select>
    </div>
  </fieldset>

  <label class="flex items-center gap-2 text-sm">
    <input type="checkbox" name="enabled" value="yes" checked={value.enabled} />
    Switched on
  </label>

  <div class="flex flex-wrap items-center gap-2">
    <button class="rounded-lg px-4 py-2.5 text-sm font-medium text-white" style="background: var(--color-brand-600)">Save</button>
    <a href="/growth/skills" class="muted rounded-lg border px-3 py-2.5 text-sm" style="border-color: var(--border)">Cancel</a>
  </div>
</form>
