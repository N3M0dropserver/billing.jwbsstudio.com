---
/**
 * The activity timeline.
 *
 * One vertical rail, newest at the top. Colour carries the tone — what you
 * sent, what the client did, money, and anything that went wrong — so the
 * shape of a chase is readable at a glance without reading a single row.
 */
import type { TimelineEntry } from '~/lib/activity/timeline';

interface Props {
  entries: TimelineEntry[];
  /** Link each row to its invoice. Off on an invoice's own page. */
  showInvoice?: boolean;
  emptyMessage?: string;
}

const { entries, showInvoice = false, emptyMessage = 'Nothing yet.' } = Astro.props;

const TONE_COLOURS: Record<string, string> = {
  neutral: 'var(--text-muted)',
  outbound: 'var(--color-reserved)',
  engagement: 'var(--color-brand-600)',
  money: 'var(--color-paid)',
  problem: 'var(--color-overdue)',
};

/** A glyph per kind, falling back to a dot for anything unmapped. */
const ICONS: Record<string, string> = {
  created: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6',
  sent: 'm22 2-7 20-4-9-9-4z',
  'reminder-sent': 'M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0',
  'send-failed': 'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z',
  'email-opened': 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2zm18 2-10 7L2 6',
  viewed: 'M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  'pdf-downloaded': 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3',
  'payment-started': 'M2 5h20v14H2zM2 10h20',
  'payment-recorded': 'M2 5h20v14H2zM2 10h20',
  paid: 'M20 6 9 17l-5-5',
  note: 'M4 4h16v12H8l-4 4z',
  email: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2zm18 2-10 7L2 6',
  call: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z',
  meeting: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',
  'follow-up': 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
  'proposal-sent': 'm22 2-7 20-4-9-9-4z',
  'invoice-sent': 'm22 2-7 20-4-9-9-4z',
};
const DOT = 'M12 12h.01';

/**
 * Local time, because every timestamp in the log is a moment rather than a
 * date on an invoice — "yesterday 4:12 pm" is what you want when you are
 * working out whether they read the reminder before replying.
 */
const formatWhen = (iso: string) =>
  new Date(iso).toLocaleString('en-NZ', {
    day: 'numeric',
    month: 'short',
    hour: 'numeric',
    minute: '2-digit',
  });

const formatDay = (iso: string) =>
  new Date(iso).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric' });
---

{
  entries.length === 0 ? (
    <p class="muted text-sm">{emptyMessage}</p>
  ) : (
    <ol class="relative space-y-4">
      {entries.map((entry, index) => (
        <li class="relative flex gap-3">
          {index < entries.length - 1 && (
            <span
              aria-hidden="true"
              class="absolute left-[11px] top-6 bottom-[-1.25rem] w-px"
              style="background: var(--border)"
            />
          )}

          <span
            aria-hidden="true"
            class="relative z-10 grid size-6 shrink-0 place-items-center rounded-full"
            style={`background: color-mix(in oklch, ${TONE_COLOURS[entry.tone]} 15%, var(--surface-raised)); color: ${TONE_COLOURS[entry.tone]}`}
          >
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={ICONS[entry.kind] ?? DOT} />
            </svg>
          </span>

          <div class="min-w-0 flex-1 pb-0.5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
              <p class="text-sm font-medium">{entry.label}</p>
              <time class="muted shrink-0 text-xs" datetime={entry.at} title={formatDay(entry.at)}>
                {formatWhen(entry.at)}
              </time>
            </div>

            {entry.note && <p class="muted mt-0.5 text-sm leading-relaxed">{entry.note}</p>}

            {showInvoice && entry.invoiceNumber && entry.invoiceId && (
              <p class="mt-1 text-xs">
                <a href={`/invoices/${entry.invoiceId}`} class="muted hover:underline">
                  {entry.invoiceNumber}
                </a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}
