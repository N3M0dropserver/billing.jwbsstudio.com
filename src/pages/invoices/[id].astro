---
import AppLayout from '~/layouts/AppLayout.astro';
import Card from '~/components/ui/Card.astro';
import StatusBadge from '~/components/ui/StatusBadge.astro';
import { eq, desc } from 'drizzle-orm';
import { db, appUrl } from '~/lib/env';
import { getSettings } from '~/lib/queries/settings';
import { getInvoice } from '~/lib/invoices/service';
import { deriveStatus } from '~/lib/invoices/calculate';
import { payments } from '~/lib/db/schema';
import { formatMoneyWithCode } from '~/lib/tax/money';
import { listTemplates } from '~/lib/queries/templates';
import { sendsFor } from '~/lib/queries/sends';

const user = Astro.locals.user!;
const database = db();
const invoice = await getInvoice(database, user.id, Astro.params.id!);

if (!invoice) return Astro.redirect('/invoices', 302);

const settings = await getSettings(database, user.id);
const status = deriveStatus(invoice);
const paymentRows = await database
  .select()
  .from(payments)
  .where(eq(payments.invoiceId, invoice.id))
  .orderBy(desc(payments.receivedOn));

const outstanding = invoice.total - invoice.amountPaid;
const publicUrl = invoice.publicToken ? `${appUrl()}/pay/${invoice.publicToken}` : null;

const sent = Astro.url.searchParams.get('sent');

// The send panel offers templates of the kind it is about to send. A reminder
// on an already-sent invoice is a different kind of letter from the first one.
const sendKind = invoice.sentAt ? 'reminder' : 'invoice';
const templates = (await listTemplates(database, user.id)).filter((t) => t.kind === sendKind);
const sends = await sendsFor(database, user.id, 'invoice', invoice.id);
const lastSend = sends[0] ?? null;
const reason = Astro.url.searchParams.get('reason');
const paymentFlag = Astro.url.searchParams.get('payment');

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-NZ', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });

const quantity = (thousandths: number) =>
  (thousandths / 1000).toFixed(2).replace(/\.00$/, '');
---

<AppLayout title={invoice.number} subtitle={invoice.client?.name ?? 'Manual entry'} width="wide">
  <div slot="actions" class="flex flex-wrap gap-2">
    <a href={`/api/invoices/${invoice.id}/pdf`} target="_blank" rel="noopener" class="btn btn-secondary">Download PDF</a>
    {publicUrl && (
      <a href={publicUrl} target="_blank" rel="noopener" class="btn btn-secondary">
        Client view
      </a>
    )}
  </div>

  {sent === 'ok' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-paid)">Invoice emailed.</p>
  )}
  {sent === 'failed' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-overdue)">
      Could not send: {reason}
    </p>
  )}
  {sent === 'no-email' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-overdue)">
      No email address on file for this client.
    </p>
  )}
  {paymentFlag === 'ok' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-paid)">Payment recorded.</p>
  )}

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <Card>
        <div class="mb-5 flex flex-wrap items-start justify-between gap-x-4 gap-y-4">
          <div class="min-w-0">
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <StatusBadge status={status} />
              {invoice.isManualEntry && <span class="label-xs muted">Manual entry</span>}
            </div>
            <p class="muted text-sm">Issued {formatDate(invoice.issuedOn)}</p>
            <p class="muted text-sm">Due {formatDate(invoice.dueOn)}</p>
            {invoice.reference && <p class="muted text-sm">Ref: {invoice.reference}</p>}
          </div>
          <div class="sm:text-right">
            <p class="label muted">Amount due</p>
            <p
              class="tabular mt-1.5 leading-none font-semibold tracking-tight"
              style={`font-size: clamp(1.75rem, 7vw, 2.25rem); ${outstanding > 0 ? '' : 'color: var(--color-paid)'}`}
            >
              {formatMoneyWithCode(outstanding, invoice.currency)}
            </p>
          </div>
        </div>

        {/* Qty and rate fold under the description below 640px so the amount
            column keeps its width. */}
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b text-left" style="border-color: var(--border-strong)">
              <th scope="col" class="label muted pb-2 font-medium">Description</th>
              <th scope="col" class="label muted hidden pb-2 pl-4 text-right font-medium sm:table-cell">Qty</th>
              <th scope="col" class="label muted hidden pb-2 pl-4 text-right font-medium sm:table-cell">Rate</th>
              <th scope="col" class="label muted pb-2 pl-4 text-right font-medium">Amount</th>
            </tr>
          </thead>
          <tbody>
            {invoice.lines.map((line) => (
              <tr class="border-b last:border-0" style="border-color: var(--border)">
                <td class="py-3 pr-3 align-top">
                  <span class="block">{line.description}</span>
                  <span class="tabular muted mt-0.5 block text-xs sm:hidden">
                    {quantity(line.quantity)} {line.unit} × {formatMoneyWithCode(line.unitPrice, invoice.currency)}
                  </span>
                </td>
                <td class="tabular muted hidden py-3 pl-4 text-right align-top whitespace-nowrap sm:table-cell">
                  {quantity(line.quantity)} {line.unit}
                </td>
                <td class="tabular muted hidden py-3 pl-4 text-right align-top whitespace-nowrap sm:table-cell">
                  {formatMoneyWithCode(line.unitPrice, invoice.currency)}
                </td>
                <td class="tabular py-3 pl-4 text-right align-top whitespace-nowrap">
                  {formatMoneyWithCode(line.lineTotal, invoice.currency)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <dl class="mt-4 ml-auto w-full space-y-1.5 text-sm sm:max-w-xs">
          <div class="flex justify-between gap-3">
            <dt class="muted">Subtotal</dt>
            <dd class="tabular">{formatMoneyWithCode(invoice.subtotal, invoice.currency)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="muted">
              {invoice.gstTreatment === 'standard'
                ? invoice.jurisdiction === 'NZ' ? 'GST 15%' : 'GST 10%'
                : invoice.gstTreatment === 'zero-rated-export'
                  ? invoice.jurisdiction === 'NZ' ? 'Zero-rated export' : 'GST-free export'
                  : 'No GST'}
            </dt>
            <dd class="tabular">{formatMoneyWithCode(invoice.gstAmount, invoice.currency)}</dd>
          </div>
          <div class="flex justify-between gap-3 border-t pt-1.5 font-semibold" style="border-color: var(--border)">
            <dt>Total</dt>
            <dd class="tabular">{formatMoneyWithCode(invoice.total, invoice.currency)}</dd>
          </div>
          {invoice.amountPaid > 0 && (
            <div class="flex justify-between gap-3">
              <dt class="muted">Paid</dt>
              <dd class="tabular" style="color: var(--color-paid)">
                −{formatMoneyWithCode(invoice.amountPaid, invoice.currency)}
              </dd>
            </div>
          )}
        </dl>

        {invoice.notes && (
          <p class="muted mt-5 border-t pt-4 text-sm" style="border-color: var(--border)">{invoice.notes}</p>
        )}
      </Card>

      {paymentRows.length > 0 && (
        <Card title="Payments">
          <ul class="space-y-2 text-sm">
            {paymentRows.map((payment) => (
              <li class="flex items-baseline justify-between gap-3">
                <span class="muted">{formatDate(payment.receivedOn)} · {payment.method}</span>
                <span class="tabular font-medium">{formatMoneyWithCode(payment.amount, payment.currency)}</span>
              </li>
            ))}
          </ul>
        </Card>
      )}
    </div>

    <div class="space-y-4">
      {outstanding > 0 && (
        <Card title="Record a payment" subtitle="Leave the amount blank to mark it paid in full">
          <form method="post" action={`/api/invoices/${invoice.id}/payments`} class="space-y-3">
            <div>
              <label for="amount" class="label muted mb-1.5 block">Amount</label>
              <input id="amount" name="amount" inputmode="decimal" placeholder={String(outstanding / 100)} class="field" />
            </div>
            <div>
              <label for="receivedOn" class="label muted mb-1.5 block">Received on</label>
              <input
                id="receivedOn" name="receivedOn" type="date"
                value={new Date().toISOString().slice(0, 10)} class="field"
              />
            </div>
            <div>
              <label for="method" class="label muted mb-1.5 block">Method</label>
              <select id="method" name="method" class="field">
                <option value="bank-transfer">Bank transfer</option>
                <option value="stripe">Stripe</option>
                <option value="wise">Wise</option>
                <option value="paypal">PayPal</option>
                <option value="cash">Cash</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="fee" class="label muted mb-1.5 block">
                Fee deducted
              </label>
              <input id="fee" name="fee" inputmode="decimal" placeholder="0.00" class="field" />
              <p class="muted mt-1 text-xs">
                Merchant fees are deductible — record them here rather than banking the net.
              </p>
            </div>
            <button class="btn btn-primary w-full">
              Record payment
            </button>
          </form>
        </Card>
      )}

      <Card title={invoice.sentAt ? 'Send a reminder' : 'Send to client'}>
        <form method="post" action={`/api/invoices/${invoice.id}/send`} class="space-y-3">
          {invoice.sentAt && <input type="hidden" name="kind" value="reminder" />}
          <div>
            <label for="to" class="label muted mb-1.5 block">To</label>
            <input id="to" name="to" type="email" value={invoice.client?.email ?? ''} required class="field" />
          </div>
          {templates.length > 0 && (
            <div>
              <label for="templateId" class="label muted mb-1.5 block">Template</label>
              <select id="templateId" name="templateId" class="field">
                {templates.map((template) => (
                  <option value={template.id} selected={template.isDefault}>
                    {template.name}{template.isDefault ? ' (default)' : ''}
                  </option>
                ))}
                <option value="none" selected={!templates.some((t) => t.isDefault)}>
                  Standard built-in wording
                </option>
              </select>
              <p class="muted mt-1 text-xs">
                <a href="/templates" class="underline">Edit templates</a>
              </p>
            </div>
          )}
          <div>
            <label for="message" class="label muted mb-1.5 block">Message (optional)</label>
            <textarea id="message" name="message" rows="3" class="field" placeholder="Leave blank for the standard wording"></textarea>
            {templates.length > 0 && (
              <p class="muted mt-1 text-xs">
                A template only uses this if it includes the <code>{'{{message}}'}</code> variable.
              </p>
            )}
          </div>
          <button class="btn btn-primary w-full">
            {invoice.sentAt ? 'Send reminder' : 'Send invoice'}
          </button>
          {invoice.sentAt && (
            <p class="muted text-xs">
              Sent {formatDate(invoice.sentAt.slice(0, 10))}
              {invoice.remindersSent > 0 && ` · ${invoice.remindersSent} reminder${invoice.remindersSent === 1 ? '' : 's'}`}
            </p>
          )}
          {lastSend?.firstOpenedAt && (
            <p class="muted text-xs">
              {/*
                Deliberately hedged. Apple Mail prefetches images without anyone
                reading the message and Gmail caches them, so this is a hint,
                not a fact. The invoice status is driven by the client actually
                opening the link, never by this.
              */}
              Email image loaded {formatDate(lastSend.firstOpenedAt.slice(0, 10))}
              {lastSend.openCount > 1 && ` · ${lastSend.openCount} times`}
              {lastSend.likelyPrefetch && ' — looks like an automatic scan rather than a person'}
            </p>
          )}
        </form>
      </Card>

      {publicUrl && (
        <Card title="Client link" subtitle="Anyone with this link can view and pay">
          <input readonly value={publicUrl} class="field text-xs" onclick="this.select()" />
        </Card>
      )}
    </div>
  </div>
</AppLayout>
