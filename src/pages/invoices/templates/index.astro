---
import AppLayout from '~/layouts/AppLayout.astro';
import { db } from '~/lib/env';
import {
  listInvoiceTemplates,
  seedInvoiceTemplates,
} from '~/lib/queries/invoice-templates';
import { LAYOUT_LABELS } from '~/lib/pdf/template';

const user = Astro.locals.user!;
const database = db();

/*
 * Seeded on first look rather than at signup.
 *
 * An account that never opens this page has no rows, and `designFor` falls
 * back to the built-in design — which is the exact invoice this system
 * produced before templates existed. Nobody's invoices change appearance
 * because the feature shipped.
 */
const existing = await listInvoiceTemplates(database, user.id);
const templates = existing.length ? existing : await seedInvoiceTemplates(database, user.id);
---

<AppLayout
  title="Invoice templates"
  subtitle="How your invoices look — layout, colours and your logo."
  width="wide"
>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {
      templates.map((template) => (
        <a
          href={`/invoices/templates/${template.id}`}
          class="card flex flex-col gap-3 p-4 transition-shadow hover:shadow-md"
        >
          {/* A swatch of the actual palette reads faster than any label. */}
          <div
            class="flex h-24 items-end gap-1.5 rounded-lg p-3"
            style={`background: ${template.parsed.theme.background}; border: 1px solid ${template.parsed.theme.rule}`}
          >
            <span
              class="h-full w-10 rounded"
              style={`background: ${template.parsed.theme.accent}`}
            />
            <span class="flex flex-1 flex-col gap-1.5">
              <span class="block h-2 w-3/4 rounded" style={`background: ${template.parsed.theme.text}`} />
              <span class="block h-1.5 w-full rounded" style={`background: ${template.parsed.theme.muted}`} />
              <span class="block h-1.5 w-5/6 rounded" style={`background: ${template.parsed.theme.muted}`} />
              <span class="block h-1.5 w-2/3 rounded" style={`background: ${template.parsed.theme.rule}`} />
            </span>
          </div>

          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <h2 class="truncate font-medium">{template.name}</h2>
              <p class="muted text-xs">
                {LAYOUT_LABELS[template.parsed.layout]}
                {template.parsed.logo.key ? ' · with logo' : ''}
              </p>
            </div>
            {template.isDefault && (
              <span class="shrink-0 rounded-full bg-[var(--surface-2)] px-2 py-0.5 text-xs">
                Default
              </span>
            )}
          </div>

          {template.description && <p class="muted text-sm">{template.description}</p>}
        </a>
      ))
    }

    <form method="post" action="/api/invoice-templates/new" class="contents">
      <button
        type="submit"
        class="card flex min-h-[13rem] flex-col items-center justify-center gap-2 border-2 border-dashed border-[var(--line)] p-4 text-sm transition-colors hover:border-[var(--accent)]"
      >
        <span class="text-2xl leading-none">+</span>
        <span>New template</span>
      </button>
    </form>
  </div>
</AppLayout>
