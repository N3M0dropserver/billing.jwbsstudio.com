---
import AppLayout from '~/layouts/AppLayout.astro';
import StatusBadge from '~/components/ui/StatusBadge.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import { db } from '~/lib/env';
import { listInvoices } from '~/lib/invoices/service';
import { formatMoneyWithCode } from '~/lib/tax/money';

const user = Astro.locals.user!;
const status = Astro.url.searchParams.get('status') ?? 'all';
const rows = await listInvoices(db(), user.id, { status });

const tabs = [
  { key: 'all', label: 'All' },
  { key: 'draft', label: 'Drafts' },
  { key: 'unpaid', label: 'Unpaid' },
  { key: 'overdue', label: 'Overdue' },
  { key: 'paid', label: 'Paid' },
];

const totals = rows.reduce(
  (acc, row) => {
    acc.total += row.total;
    acc.outstanding += row.total - row.amountPaid;
    return acc;
  },
  { total: 0, outstanding: 0 },
);

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-NZ', {
    day: 'numeric', month: 'short', year: '2-digit', timeZone: 'UTC',
  });
const today = new Date().toISOString().slice(0, 10);
const isOverdue = (row: (typeof rows)[number]) => row.dueOn < today && row.status !== 'paid';
---

<AppLayout
  title="Invoices"
  subtitle={`${rows.length} invoice${rows.length === 1 ? '' : 's'} · ${formatMoneyWithCode(totals.outstanding, 'NZD')} outstanding`}
  width="wide"
>
  <div slot="actions" class="flex items-center gap-2">
    <a href="/invoices/templates" class="btn btn-secondary">Templates</a>
    <a href="/invoices/new" class="btn btn-primary">New invoice</a>
  </div>

  <!-- Filters scroll sideways on a phone rather than wrapping into three rows. -->
  <div class="-mx-4 mb-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
    <div class="flex w-max gap-1.5 sm:w-auto sm:flex-wrap">
      {
        tabs.map((tab) => (
          <a
            href={`/invoices?status=${tab.key}`}
            class:list={['seg', status === tab.key && 'seg-on']}
            aria-current={status === tab.key ? 'page' : undefined}
          >{tab.label}</a>
        ))
      }
    </div>
  </div>

  {
    rows.length === 0 ? (
      <EmptyState
        title="No invoices here yet"
        description="Create one from scratch, or pull in unbilled time from the time tracker."
        actionHref="/invoices/new"
        actionLabel="New invoice"
      />
    ) : (
      <>
        {/* Phones: one tappable row per invoice, with the figures stacked. */}
        <div class="card divide-y overflow-hidden lg:hidden" style="border-color: var(--border)">
          {rows.map((row) => (
            <a href={`/invoices/${row.id}`} class="block px-4 py-3.5" style="border-color: var(--border)">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="label">{row.number}</p>
                  <p class="muted mt-1 truncate text-sm">{row.clientName ?? 'Manual entry'}</p>
                </div>
                <StatusBadge status={row.status} />
              </div>
              <div class="mt-2.5 flex items-baseline justify-between gap-3">
                <p class="tabular text-base font-semibold">
                  {row.total - row.amountPaid > 0
                    ? formatMoneyWithCode(row.total - row.amountPaid, row.currency)
                    : formatMoneyWithCode(row.total, row.currency)}
                </p>
                <p
                  class="label-xs"
                  style={isOverdue(row) ? 'color: var(--color-overdue)' : 'color: var(--text-muted)'}
                >
                  {row.total - row.amountPaid > 0 ? 'Due' : 'Issued'}{' '}
                  {formatDate(row.total - row.amountPaid > 0 ? row.dueOn : row.issuedOn)}
                </p>
              </div>
            </a>
          ))}
          <div class="flex items-baseline justify-between gap-3 px-4 py-3" style="background: var(--surface-sunken); border-color: var(--border)">
            <span class="label muted">{rows.length} total</span>
            <span class="tabular text-sm font-semibold">{formatMoneyWithCode(totals.outstanding, 'NZD')}</span>
          </div>
        </div>

        {/* Desktop: the full grid, where every column has room. */}
        <div class="card hidden overflow-hidden lg:block">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left" style="border-color: var(--border)">
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Number</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Client</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Issued</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Due</th>
                <th scope="col" class="label muted px-4 py-2.5 text-right font-medium">Total</th>
                <th scope="col" class="label muted px-4 py-2.5 text-right font-medium">Outstanding</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Status</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr class="border-b last:border-0" style="border-color: var(--border)">
                  <td class="px-4 py-2.5">
                    <a href={`/invoices/${row.id}`} class="font-medium hover:underline">{row.number}</a>
                    {row.isManualEntry && <span class="label-xs muted ml-1.5">manual</span>}
                  </td>
                  <td class="muted px-4 py-2.5">{row.clientName ?? '—'}</td>
                  <td class="tabular muted px-4 py-2.5 whitespace-nowrap">{formatDate(row.issuedOn)}</td>
                  <td
                    class="tabular px-4 py-2.5 whitespace-nowrap"
                    style={isOverdue(row) ? 'color: var(--color-overdue)' : 'color: var(--text-muted)'}
                  >{formatDate(row.dueOn)}</td>
                  <td class="tabular px-4 py-2.5 text-right">{formatMoneyWithCode(row.total, row.currency)}</td>
                  <td class="tabular px-4 py-2.5 text-right font-medium">
                    {row.total - row.amountPaid > 0
                      ? formatMoneyWithCode(row.total - row.amountPaid, row.currency)
                      : '—'}
                  </td>
                  <td class="px-4 py-2.5"><StatusBadge status={row.status} /></td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-t" style="border-color: var(--border); background: var(--surface-sunken)">
                <td class="label muted px-4 py-2.5" colspan="4">{rows.length} invoices</td>
                <td class="tabular px-4 py-2.5 text-right font-medium">{formatMoneyWithCode(totals.total, 'NZD')}</td>
                <td class="tabular px-4 py-2.5 text-right font-medium">{formatMoneyWithCode(totals.outstanding, 'NZD')}</td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </>
    )
  }
</AppLayout>
