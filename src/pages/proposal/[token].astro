---
/**
 * Public quote view. No session required — the token IS the credential, the
 * same arrangement as the pay page. Nothing here exposes anything beyond the
 * single quote it belongs to.
 *
 * The client can accept or decline from this page, and that acceptance is the
 * agreement the eventual invoice rests on. It does NOT raise the invoice:
 * that consumes an invoice number and starts a payment clock, which is the
 * sender's decision.
 */
import '~/styles/app.css';
import { eq } from 'drizzle-orm';
import { db, appUrl } from '~/lib/env';
import { getQuoteByToken, hasLapsed } from '~/lib/quotes/service';
import { getSettings } from '~/lib/queries/settings';
import { proposals } from '~/lib/db/schema';
import { formatMoneyWithCode } from '~/lib/tax/money';

const token = Astro.params.token!;
const database = db();
const quote = await getQuoteByToken(database, token);

if (!quote) return new Response('Quote not found', { status: 404 });

// A draft has not been sent and should not be readable by its token yet.
if (quote.status === 'draft') return new Response('Quote not found', { status: 404 });

const settings = await getSettings(database, quote.userId);
const lapsed = hasLapsed(quote);

if (!quote.viewedAt) {
  await database
    .update(proposals)
    .set({ viewedAt: new Date().toISOString(), status: quote.status === 'sent' ? 'viewed' : quote.status })
    .where(eq(proposals.id, quote.id));
}

const q = Astro.url.searchParams;
const accepted = q.get('accepted') === '1' || quote.status === 'accepted';
const declined = q.get('declined') === '1' || quote.status === 'declined';
const error = q.get('error');

const gstLabel =
  quote.gstTreatment === 'standard'
    ? quote.jurisdiction === 'NZ' ? 'GST 15%' : 'GST 10%'
    : quote.gstTreatment === 'zero-rated-export'
      ? quote.jurisdiction === 'NZ' ? 'Zero-rated export' : 'GST-free export'
      : 'No GST';

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-NZ', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });
---

<!doctype html>
<html lang="en-NZ" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Quote {quote.number} · {settings.businessName}</title>
  </head>
  <body class="px-4 py-10">
    <main class="mx-auto w-full max-w-2xl">
      <div class="card p-6 sm:p-8">
        <header class="mb-8 flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-lg font-semibold" style="color: var(--color-brand-600)">
              {settings.businessName}
            </p>
            <p class="muted mt-0.5 text-sm">{settings.email}</p>
          </div>
          <div class="text-right">
            <p class="text-sm font-semibold tracking-wide">QUOTE</p>
            <p class="muted text-sm">{quote.number}</p>
          </div>
        </header>

        <h1 class="mb-1 text-xl font-semibold">{quote.title}</h1>
        <p class="muted mb-8 text-sm">
          For {quote.client?.name ?? 'you'}
          {quote.expiresOn && ` · holds until ${formatDate(quote.expiresOn)}`}
        </p>

        {error && (
          <p
            class="mb-6 rounded-lg px-4 py-3 text-sm"
            style="background: color-mix(in oklch, var(--color-overdue) 12%, transparent); color: var(--color-overdue)"
          >{error}</p>
        )}

        {accepted && (
          <div
            class="mb-8 rounded-lg px-4 py-4 text-center text-sm"
            style="background: color-mix(in oklch, var(--color-paid) 14%, transparent); color: var(--color-paid)"
          >
            <p class="font-medium">Accepted — thank you.</p>
            <p class="mt-1 opacity-90">
              {quote.acceptedName && `Accepted by ${quote.acceptedName}. `}
              An invoice will follow. Nothing is payable until it arrives.
            </p>
          </div>
        )}

        {declined && !accepted && (
          <div class="muted mb-8 rounded-lg px-4 py-4 text-center text-sm" style="background: var(--surface-sunken)">
            You have declined this quote. If that was a mistake, just reply to the email.
          </div>
        )}

        {lapsed && !accepted && !declined && (
          <div
            class="mb-8 rounded-lg px-4 py-4 text-center text-sm"
            style="background: color-mix(in oklch, var(--color-overdue) 12%, transparent); color: var(--color-overdue)"
          >
            This quote expired on {quote.expiresOn && formatDate(quote.expiresOn)}. Ask for a fresh one
            — prices and availability may have moved.
          </div>
        )}

        {quote.body && (
          <p class="mb-8 text-sm leading-relaxed whitespace-pre-wrap">{quote.body}</p>
        )}

        <table class="w-full text-sm">
          <thead>
            <tr class="muted border-b text-left text-xs" style="border-color: var(--border)">
              <th scope="col" class="py-2 font-medium">Description</th>
              <th scope="col" class="py-2 text-right font-medium">Qty</th>
              <th scope="col" class="py-2 text-right font-medium">Amount</th>
            </tr>
          </thead>
          <tbody>
            {quote.lines.map((line) => (
              <tr class="border-b last:border-0" style="border-color: var(--border)">
                <td class="py-2.5 pr-3">{line.description}</td>
                <td class="tabular muted py-2.5 text-right whitespace-nowrap">
                  {(line.quantity / 1000).toFixed(2).replace(/\.00$/, '')} {line.unit}
                </td>
                <td class="tabular py-2.5 text-right">{formatMoneyWithCode(line.lineTotal, quote.currency)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <dl class="mt-4 ml-auto max-w-xs space-y-1.5 text-sm">
          <div class="flex justify-between gap-3">
            <dt class="muted">Subtotal</dt>
            <dd class="tabular">{formatMoneyWithCode(quote.subtotal, quote.currency)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="muted">{gstLabel}</dt>
            <dd class="tabular">{formatMoneyWithCode(quote.gstAmount, quote.currency)}</dd>
          </div>
          <div class="flex justify-between gap-3 border-t pt-1.5 text-base font-semibold" style="border-color: var(--border)">
            <dt>Total</dt>
            <dd class="tabular">{formatMoneyWithCode(quote.total, quote.currency)}</dd>
          </div>
        </dl>

        {!accepted && !declined && !lapsed && (
          <div class="mt-8 border-t pt-6" style="border-color: var(--border)">
            <form method="post" action="/api/quotes/respond" class="space-y-3">
              <input type="hidden" name="token" value={token} />
              <input type="hidden" name="action" value="accept" />
              <label for="name" class="muted block text-xs font-medium uppercase tracking-wide">
                Your name
              </label>
              <input
                id="name" name="name" required class="field"
                placeholder="So we both have a record of who agreed"
                autocomplete="name"
              />
              <button
                class="w-full rounded-lg px-4 py-3 text-sm font-medium text-white"
                style="background: var(--color-brand-600)"
              >
                Accept this quote — {formatMoneyWithCode(quote.total, quote.currency)}
              </button>
              <p class="muted text-center text-xs">
                Accepting agrees the work and the price. An invoice follows separately;
                nothing is payable now.
              </p>
            </form>

            <details class="mt-5">
              <summary class="muted cursor-pointer text-xs">Not right? Decline it</summary>
              <form method="post" action="/api/quotes/respond" class="mt-3 space-y-2">
                <input type="hidden" name="token" value={token} />
                <input type="hidden" name="action" value="decline" />
                <input name="reason" class="field text-sm" placeholder="Anything you would like us to know (optional)" />
                <button
                  class="muted w-full rounded-lg border px-4 py-2 text-sm hover:opacity-80"
                  style="border-color: var(--border)"
                >Decline</button>
              </form>
            </details>
          </div>
        )}

        {quote.terms && (
          <p class="muted mt-6 border-t pt-5 text-sm whitespace-pre-wrap" style="border-color: var(--border)">
            {quote.terms}
          </p>
        )}

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t pt-5" style="border-color: var(--border)">
          <p class="muted text-xs">{settings.invoiceFooter || settings.businessName}</p>
          <a
            href={`${appUrl()}/proposal/${token}/pdf`}
            class="muted rounded-md border px-3 py-1.5 text-xs hover:opacity-80"
            style="border-color: var(--border)"
          >Download PDF</a>
        </div>
      </div>
    </main>
  </body>
</html>
