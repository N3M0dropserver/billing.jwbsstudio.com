---
/**
 * Public proposal view.
 *
 * Two quite different things arrive through this one route, because both are
 * rows in `proposals` addressed by the same public token:
 *
 *   - a QUOTE sent to a client, who can accept or decline it here;
 *   - an unsolicited CONCEPT from a growth campaign, sent to someone who did
 *     not ask for it.
 *
 * Belonging to a campaign is what tells them apart. The route is shared
 * rather than split because the tokens are drawn from one column and are
 * already out in sent mail; giving either kind its own path would break
 * links that have been delivered.
 *
 * No session either way — the token IS the credential, the same arrangement
 * as the pay page, and neither view shows anything beyond the single row it
 * belongs to.
 */
import { eq } from 'drizzle-orm';
import { db } from '~/lib/env';
import { proposals } from '~/lib/db/schema';
import ConceptView from '~/components/proposal/ConceptView.astro';
import QuoteView from '~/components/proposal/QuoteView.astro';

const token = Astro.params.token!;
const database = db();

const rows = await database
  .select()
  .from(proposals)
  .where(eq(proposals.publicToken, token))
  .limit(1);

const proposal = rows[0];
if (!proposal) return new Response('Not found', { status: 404 });

const isConcept = Boolean(proposal.campaignId);

// A quote that has not been sent should not be readable by its token yet. A
// campaign proposal is left to ConceptView, which renders a draft but only
// records a view once it has actually been sent.
if (!isConcept && proposal.status === 'draft') {
  return new Response('Quote not found', { status: 404 });
}
---

{isConcept ? <ConceptView proposal={proposal} /> : <QuoteView token={token} />}
