---
import AppLayout from '~/layouts/AppLayout.astro';
const error = Astro.url.searchParams.get('error');
const done = Astro.url.searchParams.get('changed') === '1';
const mustChange = Astro.locals.user?.mustChangePassword;
---
<AppLayout
  title="Change password"
  subtitle={mustChange ? 'Choose a password before you continue.' : 'Update the password on your account.'}
  width="narrow"
>
  {done && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-paid)">
      Password changed. Every other session has been signed out.
    </p>
  )}
  {error && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-overdue)">{error}</p>
  )}

  <form method="post" action="/api/auth/password" class="card space-y-4 p-6">
    {!mustChange && (
      <div>
        <label for="current" class="mb-1.5 block text-sm font-medium">Current password</label>
        <input id="current" name="current" type="password" required autocomplete="current-password" class="field" />
      </div>
    )}
    <div>
      <label for="password" class="mb-1.5 block text-sm font-medium">New password</label>
      <input id="password" name="password" type="password" required minlength="12" autocomplete="new-password" class="field" />
      <p class="muted mt-1.5 text-xs">At least 12 characters, with upper and lower case and a digit.</p>
    </div>
    <div>
      <label for="confirm" class="mb-1.5 block text-sm font-medium">Confirm new password</label>
      <input id="confirm" name="confirm" type="password" required autocomplete="new-password" class="field" />
    </div>
    <button class="rounded-lg px-4 py-2.5 text-sm font-medium text-white" style="background: var(--color-brand-600)">
      Change password
    </button>
  </form>
</AppLayout>
