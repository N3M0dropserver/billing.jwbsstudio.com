---
import AppLayout from '~/layouts/AppLayout.astro';
import Card from '~/components/ui/Card.astro';
import { and, eq, desc } from 'drizzle-orm';
import { db } from '~/lib/env';
import { prospects, styleRepertoire } from '~/lib/db/schema';

const user = Astro.locals.user!;
const database = db();

const [found, styles] = await Promise.all([
  database.select().from(prospects)
    .where(eq(prospects.userId, user.id))
    .orderBy(desc(prospects.score)).limit(50),
  database.select().from(styleRepertoire)
    .where(eq(styleRepertoire.userId, user.id)),
]);

const error = Astro.url.searchParams.get('error');

const SIGNAL_LABELS: Record<string, string> = {
  'no-website': 'No website',
  'dated-website': 'Dated website',
  'no-google-presence': 'No Google presence',
  'maps-only': 'Maps listing only',
  'poor-mobile': 'Poor on mobile',
  other: 'Other',
};
---

<AppLayout title="Find prospects" subtitle="Search a niche in a region for businesses that need what you do" width="wide">
  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <Card title="New search">
        <form method="post" action="/api/prospects/search" class="space-y-3.5">
          <div class="grid gap-3.5 sm:grid-cols-2">
            <div>
              <label for="niche" class="mb-1.5 block text-sm font-medium">Niche</label>
              <input id="niche" name="niche" required placeholder="Coffee roasters" class="field" />
            </div>
            <div>
              <label for="region" class="mb-1.5 block text-sm font-medium">Region</label>
              <input id="region" name="region" required placeholder="Wellington" class="field" />
            </div>
            <div>
              <label for="country" class="mb-1.5 block text-sm font-medium">Country</label>
              <select id="country" name="country" class="field">
                <option value="NZ">New Zealand</option>
                <option value="AU">Australia</option>
              </select>
            </div>
            <div>
              <label for="styleRepertoireId" class="mb-1.5 block text-sm font-medium">Style direction</label>
              <select id="styleRepertoireId" name="styleRepertoireId" class="field">
                <option value="">Default</option>
                {styles.map((style) => (
                  <option value={style.id}>{style.name}</option>
                ))}
              </select>
            </div>
          </div>
          <button class="rounded-lg px-4 py-2.5 text-sm font-medium text-white" style="background: var(--color-brand-600)">
            Search
          </button>
        </form>

        {error && (
          <div
            class="mt-4 rounded-lg px-4 py-3 text-sm leading-relaxed"
            style="background: color-mix(in oklch, var(--color-owing) 10%, transparent)"
          >
            <p class="font-medium" style="color: var(--color-owing)">Discovery is not wired up yet</p>
            <p class="muted mt-1">{error}</p>
          </div>
        )}
      </Card>

      <Card title="Prospects" subtitle={`${found.length} found`}>
        {found.length === 0 ? (
          <div class="muted space-y-3 text-sm leading-relaxed">
            <p>Nothing here yet.</p>
            <p>
              Scoring, qualification and proposal drafting are built and working. What is not
              connected is the discovery step — actually going out and finding businesses. That
              needs a data source, and the choice has cost and terms-of-service consequences,
              so it is left as a deliberate decision rather than a default.
            </p>
            <p>
              The seam is <code class="text-xs">discoverProspects()</code> in
              <code class="text-xs"> src/lib/ai/prospecting.ts</code>. Return an array of
              businesses from the Google Places API or an OpenStreetMap extract and the rest
              of the pipeline runs. Scraping Google Maps directly is against their terms and
              will get the Worker's egress range blocked — do not.
            </p>
          </div>
        ) : (
          <ul class="space-y-3">
            {found.map((prospect) => (
              <li class="border-b pb-3 last:border-0 last:pb-0" style="border-color: var(--border)">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-medium">{prospect.businessName}</p>
                    <p class="muted text-xs">
                      {SIGNAL_LABELS[prospect.signal] ?? prospect.signal}
                      {prospect.region && ` · ${prospect.region}`}
                    </p>
                  </div>
                  <span
                    class="tabular shrink-0 rounded-full px-2 py-0.5 text-xs font-medium"
                    style={`background: color-mix(in oklch, var(--color-brand-500) ${Math.round(prospect.score / 5)}%, transparent); color: var(--color-brand-600)`}
                  >{prospect.score}</span>
                </div>
                {prospect.notes && <p class="muted mt-1.5 text-sm leading-relaxed">{prospect.notes}</p>}
              </li>
            ))}
          </ul>
        )}
      </Card>
    </div>

    <div class="space-y-4">
      <Card title="How this is meant to work">
        <ol class="muted space-y-2.5 text-sm leading-relaxed">
          <li><strong style="color: var(--text)">1.</strong> Name a niche and a region.</li>
          <li><strong style="color: var(--text)">2.</strong> Discovery finds businesses in it.</li>
          <li><strong style="color: var(--text)">3.</strong> Each is scored on need and on ability to pay — a business with a good site scores low, honestly.</li>
          <li><strong style="color: var(--text)">4.</strong> The strong ones get a drafted proposal with a specific angle.</li>
          <li><strong style="color: var(--text)">5.</strong> A mockup is generated against one of your saved style directions and published to a subdomain.</li>
        </ol>
      </Card>

      <Card title="Style repertoire" subtitle="The references mockups are based on">
        {styles.length === 0 ? (
          <p class="muted text-sm leading-relaxed">
            No style directions saved yet. These are the reference sites and brand
            directions the generator works from, plus an editable prompt — so the output
            looks like your work rather than a generic template.
          </p>
        ) : (
          <ul class="space-y-2 text-sm">
            {styles.map((style) => (
              <li>
                <p class="font-medium">{style.name}</p>
                {style.suitableFor && <p class="muted text-xs">{style.suitableFor}</p>}
              </li>
            ))}
          </ul>
        )}
      </Card>
    </div>
  </div>
</AppLayout>
