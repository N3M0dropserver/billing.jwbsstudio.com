---
import AppLayout from '~/layouts/AppLayout.astro';
import StatusBadge from '~/components/ui/StatusBadge.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import { and, eq, sql, desc, ne } from 'drizzle-orm';
import { db } from '~/lib/env';
import { clients, invoices } from '~/lib/db/schema';
import { formatMoney } from '~/lib/tax/money';

const user = Astro.locals.user!;
const database = db();
const status = Astro.url.searchParams.get('status') ?? 'active';

const conditions = [eq(clients.userId, user.id)];
if (status !== 'all') conditions.push(eq(clients.status, status as 'active'));

const rows = await database
  .select({
    client: clients,
    invoiced: sql<number>`coalesce(sum(case when ${invoices.status} not in ('draft','void') then ${invoices.total} else 0 end), 0)`,
    outstanding: sql<number>`coalesce(sum(case when ${invoices.status} not in ('draft','void','paid','written-off') then ${invoices.total} - ${invoices.amountPaid} else 0 end), 0)`,
    lastInvoice: sql<string | null>`max(${invoices.issuedOn})`,
  })
  .from(clients)
  .leftJoin(invoices, and(eq(invoices.clientId, clients.id), ne(invoices.status, 'void')))
  .where(and(...conditions))
  .groupBy(clients.id)
  .orderBy(desc(sql`sum(case when ${invoices.status} not in ('draft','void') then ${invoices.total} else 0 end)`), clients.name);

const tabs = [
  { key: 'active', label: 'Active' },
  { key: 'lead', label: 'Leads' },
  { key: 'dormant', label: 'Dormant' },
  { key: 'all', label: 'All' },
];

const formatDate = (iso: string | null) =>
  iso
    ? new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-NZ', {
        day: 'numeric', month: 'short', year: '2-digit', timeZone: 'UTC',
      })
    : '—';
---

<AppLayout title="Clients" subtitle={`${rows.length} ${status === 'all' ? 'total' : status}`} width="wide">
  <div slot="actions" class="flex flex-wrap gap-2">
    <a href="/growth" class="btn btn-secondary">Find prospects</a>
    <a href="/clients/new" class="btn btn-primary">Add client</a>
  </div>

  <!-- Filters scroll sideways on a phone rather than wrapping into three rows. -->
  <div class="-mx-4 mb-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
    <div class="flex w-max gap-1.5 sm:w-auto sm:flex-wrap">
      {
        tabs.map((tab) => (
          <a
            href={`/clients?status=${tab.key}`}
            class:list={['seg', status === tab.key && 'seg-on']}
            aria-current={status === tab.key ? 'page' : undefined}
          >{tab.label}</a>
        ))
      }
    </div>
  </div>

  {
    rows.length === 0 ? (
      <EmptyState
        title="No clients here yet"
        description="Add one manually, or let the prospecting mode go and find businesses in a niche that need what you do."
        actionHref="/clients/new"
        actionLabel="Add client"
      />
    ) : (
      <>
        {/* Phones: one tappable row per client. */}
        <div class="card divide-y overflow-hidden lg:hidden" style="border-color: var(--border)">
          {rows.map(({ client, invoiced, outstanding, lastInvoice }) => (
            <a href={`/clients/${client.id}`} class="block px-4 py-3.5" style="border-color: var(--border)">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium">{client.name}</p>
                  {client.email && <p class="muted mt-0.5 truncate text-xs">{client.email}</p>}
                </div>
                <StatusBadge status={client.status} />
              </div>
              <div class="mt-2.5 flex items-baseline justify-between gap-3">
                <span class="label-xs muted">
                  {client.country} · Last {formatDate(lastInvoice)}
                </span>
                <span
                  class="tabular text-sm font-semibold"
                  style={outstanding > 0 ? 'color: var(--color-owing)' : ''}
                >
                  {outstanding > 0
                    ? `${formatMoney(outstanding, client.currency)} owing`
                    : formatMoney(invoiced, client.currency)}
                </span>
              </div>
            </a>
          ))}
        </div>

        {/* Desktop: the full grid. */}
        <div class="card hidden overflow-hidden lg:block">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left" style="border-color: var(--border)">
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Name</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Country</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Last invoice</th>
                <th scope="col" class="label muted px-4 py-2.5 text-right font-medium">Invoiced</th>
                <th scope="col" class="label muted px-4 py-2.5 text-right font-medium">Outstanding</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Status</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(({ client, invoiced, outstanding, lastInvoice }) => (
                <tr class="border-b last:border-0" style="border-color: var(--border)">
                  <td class="px-4 py-2.5">
                    <a href={`/clients/${client.id}`} class="font-medium hover:underline">{client.name}</a>
                    {client.email && <span class="muted block text-xs">{client.email}</span>}
                  </td>
                  <td class="muted px-4 py-2.5">
                    {client.country}
                    {client.gstTreatment === 'zero-rated-export' && (
                      <span class="label-xs muted block">zero-rated</span>
                    )}
                  </td>
                  <td class="tabular muted px-4 py-2.5 whitespace-nowrap">{formatDate(lastInvoice)}</td>
                  <td class="tabular px-4 py-2.5 text-right">{formatMoney(invoiced, client.currency)}</td>
                  <td
                    class="tabular px-4 py-2.5 text-right font-medium"
                    style={outstanding > 0 ? 'color: var(--color-owing)' : ''}
                  >{outstanding > 0 ? formatMoney(outstanding, client.currency) : '—'}</td>
                  <td class="px-4 py-2.5"><StatusBadge status={client.status} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
</AppLayout>
