---
/**
 * What the agent knows how to do, as separate pieces.
 *
 * The instructions page holds what is true for every prospect. This holds what
 * is true for some of them — and shows, for each one, which prospects it will
 * actually reach, because a skill that never matches anything is the failure
 * mode here and it is invisible without saying so.
 */
import AppLayout from '~/layouts/AppLayout.astro';
import Card from '~/components/ui/Card.astro';
import GrowthNav from '~/components/growth/GrowthNav.astro';
import { db } from '~/lib/env';
import { SKILL_STAGES, type AgentSkill } from '~/lib/growth/skills';
import { loadSkills } from '~/lib/queries/skills';

const user = Astro.locals.user!;
const skills = await loadSkills(db(), user.id);

const saved = Astro.url.searchParams.get('saved');
const removed = Astro.url.searchParams.get('removed');

const byStage = SKILL_STAGES.map((entry) => ({
  ...entry,
  skills: skills
    .filter((skill) => skill.stage === entry.stage)
    .sort((a, b) => Number(b.enabled) - Number(a.enabled) || a.name.localeCompare(b.name)),
}));

const enabled = skills.filter((skill) => skill.enabled).length;

/** Which prospects a skill reaches, in a phrase. */
function scope(skill: AgentSkill): string {
  const parts: string[] = [];
  if (skill.match.niches.length) parts.push(skill.match.niches.slice(0, 4).join(', '));
  if (skill.match.objectives.length) parts.push(skill.match.objectives.join(' or '));
  if (skill.match.website === 'with') parts.push('has a site');
  if (skill.match.website === 'without') parts.push('no site');
  return parts.length ? parts.join(' · ') : 'every prospect';
}
---

<AppLayout
  title="Skills"
  subtitle="Know-how the agent applies to some prospects rather than all of them"
>
  <GrowthNav current="skills" />

  <a slot="actions" href="/growth/skills/new" class="rounded-lg px-4 py-2 text-sm font-medium text-white" style="background: var(--color-brand-600)">New skill</a>

  {saved && <p class="muted mb-4 rounded-lg px-4 py-3 text-sm" style="background: var(--surface-sunken)" role="status">Saved.</p>}
  {removed && <p class="muted mb-4 rounded-lg px-4 py-3 text-sm" style="background: var(--surface-sunken)" role="status">Removed. A built-in is back to the version that ships with the app.</p>}

  <div class="mb-4 rounded-lg border p-4 text-sm leading-relaxed" style="border-color: var(--border)">
    <p>
      A skill is appended to one stage's prompt, for the prospects it matches. {enabled} of
      {skills.length} are on. Where a skill contradicts a general instruction, the skill wins —
      that is the point of it being narrower.
    </p>
    <p class="muted mt-2 text-xs leading-relaxed">
      The ones marked <strong style="color: var(--text)">built in</strong> ship with the app.
      Editing one keeps it yours until you remove your version, which puts the shipped one back.
    </p>
  </div>

  <div class="space-y-4">
    {
      byStage.map((group) => (
        <Card title={group.label} subtitle={group.blurb}>
          {group.skills.length === 0 ? (
            <p class="muted text-sm">Nothing at this stage yet.</p>
          ) : (
            <ul class="divide-y" style="border-color: var(--border)">
              {group.skills.map((skill) => (
                <li class="flex flex-wrap items-start justify-between gap-3 py-3 first:pt-0 last:pb-0">
                  <div class="min-w-0 flex-1">
                    <p class="flex flex-wrap items-center gap-2 font-medium">
                      <a href={`/growth/skills/${skill.slug}`} class="hover:opacity-80">{skill.name}</a>
                      {!skill.enabled && (
                        <span class="muted rounded-full px-2 py-0.5 text-xs" style="background: var(--surface-sunken)">off</span>
                      )}
                    </p>
                    <p class="muted mt-0.5 text-xs leading-relaxed">{skill.summary}</p>
                    <p class="muted mt-1 text-xs">
                      Applies to: <span style="color: var(--text)">{scope(skill)}</span>
                    </p>
                  </div>
                  <form method="post" action="/api/growth-skills" class="shrink-0">
                    <input type="hidden" name="action" value="toggle" />
                    <input type="hidden" name="slug" value={skill.slug} />
                    <input type="hidden" name="enabled" value={skill.enabled ? 'no' : 'yes'} />
                    <button class="muted rounded-lg border px-3 py-1.5 text-sm" style="border-color: var(--border)">
                      {skill.enabled ? 'Turn off' : 'Turn on'}
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </Card>
      ))
    }
  </div>
</AppLayout>
