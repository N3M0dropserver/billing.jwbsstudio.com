---
import AppLayout from '~/layouts/AppLayout.astro';
import Card from '~/components/ui/Card.astro';
import ScoreBar from '~/components/growth/ScoreBar.astro';
import { and, desc, eq } from 'drizzle-orm';
import { db } from '~/lib/env';
import { demoSites, designPlans, proposals, prospectArtifacts, prospects } from '~/lib/db/schema';
import { parseJson, readAudit, readFindings } from '~/lib/growth/engine';
import type { SocialLink } from '~/lib/growth/html';
import type { PlanSection } from '~/lib/growth/qualify';
import type { ScaleAssessment } from '~/lib/growth/scale';
import { FALLBACK_BRIEF } from '~/lib/growth/brief';
import { describeStyle, deserialiseStyle, styleFromBrief } from '~/lib/growth/style';

const user = Astro.locals.user!;
const id = Astro.params.id!;
const database = db();

const rows = await database
  .select()
  .from(prospects)
  .where(and(eq(prospects.id, id), eq(prospects.userId, user.id)))
  .limit(1);

const prospect = rows[0];
if (!prospect) return new Response('Not found', { status: 404 });

const [artifacts, demos, plans, drafts] = await Promise.all([
  database.select().from(prospectArtifacts).where(eq(prospectArtifacts.prospectId, id)),
  database.select().from(demoSites).where(eq(demoSites.prospectId, id)).orderBy(desc(demoSites.createdAt)),
  database.select().from(designPlans).where(eq(designPlans.prospectId, id)).orderBy(desc(designPlans.createdAt)),
  database.select().from(proposals).where(eq(proposals.prospectId, id)),
]);

const audit = readAudit(prospect);
const findings = readFindings(prospect);
const socials = parseJson<SocialLink[]>(prospect.socialLinks, []);
const plan = plans[0];
const demo = demos.find((row) => row.status === 'live') ?? demos[0];
const draft = drafts[0];
const sections = plan ? parseJson<PlanSection[]>(plan.sections, []) : [];

/**
 * The look this demo was built with, and where it came from.
 *
 * `kit` means nothing moved it: no reference site was readable and the model
 * did not answer, so this page looks like every other page built against the
 * same direction. That is worth saying out loud on the one screen where
 * someone is asking why a demo looks the way it does.
 */
const style = plan ? deserialiseStyle(plan.style, styleFromBrief(FALLBACK_BRIEF)) : null;
const STYLE_SOURCE: Record<string, string> = {
  model: 'Chosen for this business',
  references: 'Measured off the reference sites',
  kit: 'Straight from the saved direction — nothing moved it for this business',
};
const pages = artifacts.filter((a) => a.kind === 'page');
const images = artifacts.filter((a) => a.kind === 'image');
const failing = audit.checks.filter((check) => check.failed);
const scale = parseJson<ScaleAssessment | null>(prospect.scale, null);
const scaleHits = scale?.signals.filter((signal) => signal.hit && signal.weight > 0) ?? [];
const tooBig = findings.tooBig === true;
---

<AppLayout title={prospect.businessName} subtitle={`${prospect.niche} · ${prospect.region}`} width="wide">
  <div slot="actions" class="flex flex-wrap gap-2">
    {demo?.status === 'live' && (
      <a href={`https://${demo.host}`} target="_blank" rel="noopener" class="muted rounded-lg border px-3 py-2 text-sm" style="border-color: var(--border)">
        View the demo ↗
      </a>
    )}
    {draft && (
      <a href={`/growth/proposals/${draft.id}`} class="rounded-lg px-4 py-2 text-sm font-medium text-white" style="background: var(--color-brand-600)">
        {draft.status === 'sent' ? 'View the email' : 'Review the email'}
      </a>
    )}
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <Card title="What is wrong with their site" subtitle={audit.summary}>
        {failing.length === 0 ? (
          <p class="muted text-sm leading-relaxed">
            Nothing measurable. That is a genuine answer — there is no honest problem to lead
            with, and an email that invents one is worse than no email.
          </p>
        ) : (
          <ul class="space-y-2">
            {failing.map((check) => (
              <li class="flex items-start justify-between gap-3 border-b pb-2 text-sm last:border-0 last:pb-0" style="border-color: var(--border)">
                <span>
                  {check.label}
                  {check.detail && <span class="muted block text-xs">{check.detail}</span>}
                </span>
                <span class="muted tabular shrink-0 text-xs">+{check.weight}</span>
              </li>
            ))}
          </ul>
        )}

        {audit.observations.length > 0 && (
          <div class="mt-4 border-t pt-4" style="border-color: var(--border)">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide" style="color: var(--color-brand-600)">Safe to quote</p>
            <ul class="muted space-y-1 text-sm leading-relaxed">
              {audit.observations.map((line) => <li>{line}</li>)}
            </ul>
          </div>
        )}
      </Card>

      {plan && (
        <Card title="The design plan" subtitle={plan.summary}>
          <p class="muted text-sm leading-relaxed">{plan.strategy}</p>
          <p class="mt-3 text-xs">
            <span class="rounded px-2 py-0.5" style="background: color-mix(in oklch, var(--color-reserved) 14%, transparent); color: var(--color-reserved)">
              {plan.objective}
            </span>
          </p>

          {plan.fallbackReason && (
            <div class="mt-3 rounded border border-amber-300 bg-amber-50 p-2.5 text-xs dark:border-amber-800 dark:bg-amber-950">
              <p class="font-medium">This page was scaffolded, not written</p>
              <p class="mt-0.5">{plan.fallbackReason}</p>
              <p class="mt-1">
                A scaffold carries only the facts already held, so it will read thinner than the
                rest of the run. Re-plan this one to have the model write it.
              </p>
            </div>
          )}

          {style && (
            <div class="mt-3 rounded border p-2.5 text-xs" style="border-color: var(--border)">
              <div class="flex flex-wrap items-center gap-2">
                <p class="font-medium">{STYLE_SOURCE[style.source] ?? 'The look'}</p>
                <span class="flex gap-1">
                  {style.palette.map((colour) => (
                    <span
                      class="inline-block h-4 w-4 rounded border"
                      style={`background:${colour.value}; border-color: var(--border)`}
                      title={`${colour.value} — ${colour.role}`}
                    ></span>
                  ))}
                </span>
              </div>
              {style.rationale && <p class="muted mt-1 leading-relaxed">{style.rationale}</p>}
              <pre class="muted mt-1.5 whitespace-pre-wrap font-mono text-[11px]">{describeStyle(style)}</pre>
            </div>
          )}
          <ol class="mt-4 space-y-3">
            {sections.map((section, index) => (
              <li class="border-l-2 pl-3" style="border-color: var(--border)">
                <p class="text-sm font-medium">
                  <span class="muted tabular mr-2 text-xs">{index + 1}</span>
                  {section.heading || section.type}
                  <span class="muted ml-2 text-xs font-normal">{section.type}</span>
                </p>
                {section.subheading && <p class="muted text-xs">{section.subheading}</p>}
                {section.body && <p class="muted mt-1 text-sm leading-relaxed">{section.body}</p>}
                {section.notes && <p class="mt-1 text-xs italic" style="color: var(--color-reserved)">{section.notes}</p>}
              </li>
            ))}
          </ol>
        </Card>
      )}

      {images.length > 0 && (
        <Card title="Their photography" subtitle={`${images.length} kept from their site`}>
          <ul class="muted space-y-1 text-xs">
            {images.map((image) => (
              <li class="truncate">
                <a href={image.sourceUrl} target="_blank" rel="noopener nofollow" class="hover:opacity-80">{image.sourceUrl}</a>
              </li>
            ))}
          </ul>
          <p class="muted mt-3 text-xs leading-relaxed">
            Carried into the demo so it looks like someone looked at them. They are not licensed
            to you — replace them before anything goes live for real.
          </p>
        </Card>
      )}
    </div>

    <div class="space-y-4">
      <Card title="Score">
        <ScoreBar score={prospect.score} presenceScore={prospect.presenceScore} fitScore={prospect.fitScore} scaleScore={prospect.scaleScore} />
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between"><dt class="muted">Need (measured)</dt><dd class="tabular">{prospect.presenceScore}</dd></div>
          <div class="flex justify-between"><dt class="muted">Fit (judged)</dt><dd class="tabular">{prospect.fitScore}</dd></div>
          <div class="flex justify-between">
            <dt class="muted">Size (measured)</dt>
            <dd class="tabular" style={tooBig ? 'color: var(--color-overdue)' : ''}>{prospect.scaleScore}</dd>
          </div>
        </dl>
        {findings.reasoning && (
          <p class="muted mt-3 border-t pt-3 text-xs leading-relaxed" style="border-color: var(--border)">
            {String(findings.reasoning)}
          </p>
        )}
      </Card>

      <Card title="How big are they" subtitle={scale?.summary ?? 'Not assessed'}>
        {tooBig && (
          <p class="mb-3 rounded-lg px-3 py-2 text-xs leading-relaxed" style="background: color-mix(in oklch, var(--color-overdue) 12%, transparent); color: var(--color-overdue)">
            Ruled out on size. A speculative redesign from a freelancer lands well with an
            owner-operator and reads as an imposition to an established operation with an agency.
          </p>
        )}
        {prospect.brand && (
          <p class="muted mb-2 text-xs">Trades under <strong style="color: var(--text)">{prospect.brand}</strong></p>
        )}
        {prospect.branchCount > 1 && (
          <p class="muted mb-2 text-xs">{prospect.branchCount} branches found in this region</p>
        )}
        {scaleHits.length === 0 ? (
          <p class="muted text-sm leading-relaxed">
            Nothing suggests this is more than a single independent business — which is exactly
            what the approach is for.
          </p>
        ) : (
          <ul class="space-y-1.5">
            {scaleHits.map((signal) => (
              <li class="flex items-start justify-between gap-3 text-sm">
                <span>
                  {signal.label}
                  {signal.detail && <span class="muted block text-xs">{signal.detail}</span>}
                </span>
                <span class="muted tabular shrink-0 text-xs">+{signal.weight}</span>
              </li>
            ))}
          </ul>
        )}
      </Card>

      <Card title="Contact">
        <dl class="space-y-2 text-sm">
          {prospect.website && (
            <div><dt class="muted text-xs">Site</dt><dd class="truncate"><a href={prospect.website} target="_blank" rel="noopener nofollow">{prospect.domain || prospect.website}</a></dd></div>
          )}
          {prospect.email && <div><dt class="muted text-xs">Email</dt><dd class="truncate">{prospect.email}</dd></div>}
          {prospect.phone && <div><dt class="muted text-xs">Phone</dt><dd>{prospect.phone}</dd></div>}
          {prospect.contactName && <div><dt class="muted text-xs">Who</dt><dd>{prospect.contactName}{prospect.contactRole && `, ${prospect.contactRole}`}</dd></div>}
          {prospect.address && <div><dt class="muted text-xs">Address</dt><dd class="text-sm leading-snug">{prospect.address}</dd></div>}
          {socials.length > 0 && (
            <div>
              <dt class="muted text-xs">Social</dt>
              <dd class="flex flex-wrap gap-2 text-xs">
                {socials.map((social) => (
                  <a href={social.url} target="_blank" rel="noopener nofollow" class="rounded px-2 py-0.5" style="background: var(--surface-sunken)">{social.platform}</a>
                ))}
              </dd>
            </div>
          )}
          {prospect.rating !== null && (
            <div><dt class="muted text-xs">Rating</dt><dd class="tabular">{prospect.rating} ({prospect.reviewCount})</dd></div>
          )}
        </dl>
      </Card>

      <Card title="Status">
        <form method="post" action={`/api/prospects/${id}`} class="space-y-2">
          <select name="status" class="field">
            {['new', 'qualified', 'contacted', 'responded', 'converted', 'rejected'].map((status) => (
              <option value={status} selected={status === prospect.status}>{status}</option>
            ))}
          </select>
          <button name="action" value="status" class="muted w-full rounded-lg border px-3 py-2 text-sm" style="border-color: var(--border)">Save</button>
        </form>

        {!prospect.convertedClientId && (
          <form method="post" action={`/api/prospects/${id}`} class="mt-2">
            <button name="action" value="convert" class="w-full rounded-lg px-3 py-2 text-sm font-medium text-white" style="background: var(--color-brand-600)">
              Make them a client
            </button>
          </form>
        )}
        {prospect.convertedClientId && (
          <a href={`/clients/${prospect.convertedClientId}`} class="muted mt-2 block text-center text-sm">Open the client record →</a>
        )}
      </Card>

      <Card title="Notes">
        <form method="post" action={`/api/prospects/${id}`} class="space-y-2">
          <textarea name="notes" rows="5" class="field">{prospect.notes}</textarea>
          <button name="action" value="notes" class="muted w-full rounded-lg border px-3 py-2 text-sm" style="border-color: var(--border)">Save</button>
        </form>
      </Card>

      {pages.length > 0 && (
        <Card title="Crawled" subtitle={`${pages.length} page(s) kept`}>
          <ul class="muted space-y-1 text-xs">
            {pages.map((page) => <li class="truncate">{page.label || page.sourceUrl}</li>)}
          </ul>
        </Card>
      )}
    </div>
  </div>
</AppLayout>
