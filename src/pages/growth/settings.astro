---
import AppLayout from '~/layouts/AppLayout.astro';
import Card from '~/components/ui/Card.astro';
import StagePolicy from '~/components/growth/StagePolicy.astro';
import { eq } from 'drizzle-orm';
import { bindings, db } from '~/lib/env';
import { brandKits } from '~/lib/db/schema';
import { getSettings } from '~/lib/queries/settings';
import { resolvePolicy } from '~/lib/growth/policy';
import { PROVIDERS } from '~/lib/growth/discovery/index';
import { browserAvailable } from '~/lib/agent/context';

const user = Astro.locals.user!;
const database = db();

const [settings, kits] = await Promise.all([
  getSettings(database, user.id),
  database.select().from(brandKits).where(eq(brandKits.userId, user.id)),
]);

const policy = resolvePolicy(null, settings.growthPolicy);
const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');
const env = bindings();
const hasBrowser = browserAvailable(env);
---

<AppLayout title="Growth defaults" subtitle="What every new run starts from">
  <form method="post" action="/api/growth-settings" class="space-y-4">
    {saved && <p class="muted rounded-lg px-4 py-3 text-sm" style="background: var(--surface-sunken)" role="status">Saved.</p>}
    {error && <p class="rounded-lg px-4 py-3 text-sm" style="background: color-mix(in oklch, var(--color-owing) 12%, transparent); color: var(--color-owing)" role="alert">{error}</p>}

    <Card title="Autonomy" subtitle="A new run starts with these and can override any of them">
      <StagePolicy policy={policy} />
    </Card>

    <Card title="Outreach" subtitle="The part that reaches people who did not ask to hear from you">
      <div class="grid gap-3.5 sm:grid-cols-2">
        <div>
          <label for="outreachSenderName" class="mb-1.5 block text-sm font-medium">Sign as</label>
          <input id="outreachSenderName" name="outreachSenderName" value={settings.outreachSenderName} class="field" />
        </div>
        <div>
          <label for="outreachReplyTo" class="mb-1.5 block text-sm font-medium">Reply-to</label>
          <input id="outreachReplyTo" name="outreachReplyTo" type="email" value={settings.outreachReplyTo} class="field" placeholder={settings.email} />
        </div>
      </div>

      <div class="mt-3.5">
        <label for="outreachBio" class="mb-1.5 block text-sm font-medium">What you do</label>
        <textarea id="outreachBio" name="outreachBio" rows="3" class="field" placeholder="A sentence or two. This is what the model has to work with when it says who is writing.">{settings.outreachBio}</textarea>
      </div>

      <div class="mt-3.5">
        <label for="outreachSignature" class="mb-1.5 block text-sm font-medium">Signature</label>
        <textarea id="outreachSignature" name="outreachSignature" rows="3" class="field">{settings.outreachSignature}</textarea>
      </div>

      <div class="mt-3.5 rounded-lg border p-3.5" style="border-color: var(--border)">
        <label for="outreachDailyCap" class="mb-1.5 block text-sm font-medium">Daily cap on unattended sends</label>
        <input id="outreachDailyCap" name="outreachDailyCap" type="number" min="0" max="100" value={settings.outreachDailyCap} class="field max-w-28" />
        <p class="muted mt-2 text-xs leading-relaxed">
          The hard ceiling on emails a run will send in any rolling 24 hours with nobody watching.
          Counted from what has actually been sent, so starting a new run does not reset it.
          <strong style="color: var(--text)"> Zero switches unattended sending off entirely</strong> —
          runs still draft every email, they just wait for you to press send. Sending by hand from a
          proposal page is never capped.
        </p>
      </div>
    </Card>

    <Card title="Discovery and hosting">
      <div class="grid gap-3.5 sm:grid-cols-2">
        <div>
          <label for="growthDiscoveryProvider" class="mb-1.5 block text-sm font-medium">Default source</label>
          <select id="growthDiscoveryProvider" name="growthDiscoveryProvider" class="field">
            {PROVIDERS.map((provider) => (
              <option value={provider.name} selected={provider.name === settings.growthDiscoveryProvider}>
                {provider.label}
              </option>
            ))}
          </select>
          {!env.GOOGLE_PLACES_API_KEY && (
            <p class="muted mt-1 text-xs">Google Places needs GOOGLE_PLACES_API_KEY as a Worker secret.</p>
          )}
        </div>
        <div>
          <label for="growthBrandKitId" class="mb-1.5 block text-sm font-medium">Default style direction</label>
          <select id="growthBrandKitId" name="growthBrandKitId" class="field">
            <option value="">Built-in</option>
            {kits.map((kit) => (
              <option value={kit.id} selected={kit.id === settings.growthBrandKitId}>{kit.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="mt-3.5">
        <label for="demoHost" class="mb-1.5 block text-sm font-medium">Demos are published under</label>
        <input id="demoHost" name="demoHost" value={settings.demoHost} class="field font-mono text-sm" />
        <p class="muted mt-2 text-xs leading-relaxed">
          Each demo gets its own label, so a run produces <code>wells-coffee.{settings.demoHost}</code>.
          {env.DEMO_HOST && env.DEMO_HOST !== settings.demoHost && (
            <span style="color: var(--color-owing)">
              {' '}The Worker is configured to serve <code>{env.DEMO_HOST}</code>, so demos on
              anything else will not resolve until DEMO_HOST in wrangler.jsonc matches.
            </span>
          )}
        </p>
      </div>
    </Card>

    <Card
      title="Is demo hosting working?"
      subtitle={settings.demoHostVerified ? 'Yes — demos are linked on their own subdomain' : 'Not yet — demos are linked on this app instead'}
    >
      <div
        class="rounded-lg px-3.5 py-3 text-sm leading-relaxed"
        style={`background: color-mix(in oklch, ${settings.demoHostVerified ? 'var(--color-paid)' : 'var(--color-owing)'} 10%, transparent)`}
      >
        <p class="font-medium" style={`color: ${settings.demoHostVerified ? 'var(--color-paid)' : 'var(--color-owing)'}`}>
          {settings.demoHostVerified
            ? `Subdomains on ${settings.demoHost} resolve.`
            : 'Subdomains have not been verified.'}
        </p>
        <p class="muted mt-1 text-xs">
          {settings.demoHostCheckResult || 'Not checked yet.'}
          {settings.demoHostCheckedAt && ` (${settings.demoHostCheckedAt.slice(0, 16).replace('T', ' ')})`}
        </p>
      </div>

      {!settings.demoHostVerified && (
        <div class="muted mt-3 space-y-2 text-xs leading-relaxed">
          <p>
            <strong style="color: var(--text)">Demos still work.</strong> Until the wildcard is
            verified they are linked at <code>{`${env.APP_URL ?? ''}/d/&lt;host&gt;/`}</code> on this
            app, which needs no DNS — so a run always produces something openable and a proposal
            never contains a dead link.
          </p>
          <p>To move them onto their own subdomain, add both of these once:</p>
          <pre class="overflow-x-auto rounded-lg p-3 text-[11px]" style="background: var(--surface-sunken)">{`DNS:    *.${settings.demoHost}   CNAME   ${new URL(env.APP_URL ?? 'https://billing.jwbsstudio.com').hostname}   (proxied)
Route:  *.${settings.demoHost}/*   ->   this Worker`}</pre>
          <p>Then build at least one demo and run the check — it needs a real page to fetch.</p>
        </div>
      )}

      <button
        type="submit"
        formmethod="post"
        formaction="/api/growth-hosting-check"
        class="muted mt-3 rounded-lg border px-3 py-2 text-sm"
        style="border-color: var(--border)"
      >Check hosting now</button>
    </Card>

    <Card title="AI" subtitle="Caching and what the pipeline is allowed to look up">
      <div class="grid gap-3.5 sm:grid-cols-2">
        <div>
          <label for="aiCacheTtlHours" class="mb-1.5 block text-sm font-medium">Reuse identical requests for</label>
          <div class="flex items-center gap-2">
            <input id="aiCacheTtlHours" name="aiCacheTtlHours" type="number" min="0" max="720" value={settings.aiCacheTtlHours} class="field max-w-28" />
            <span class="muted text-sm">hours</span>
          </div>
          <p class="muted mt-1 text-xs leading-relaxed">
            A re-run of the same stage costs nothing the second time. Keyed on the model, the
            prompt and the parameters, so a changed brief is a fresh call rather than a stale
            answer. Zero turns it off.
          </p>
        </div>
        <div>
          <p class="mb-1.5 block text-sm font-medium">Looking businesses up</p>
          <p class="muted text-xs leading-relaxed">
            Wikidata is checked on every prospect — free, no key, and it catches the recognised
            brands that should never be approached cold.
            {env.SEARCH_PROVIDER && env.SEARCH_PROVIDER !== 'none' && env.SEARCH_API_KEY
              ? ` Web search is also on, via ${env.SEARCH_PROVIDER}.`
              : ' Set SEARCH_PROVIDER to "brave" or "serper" with SEARCH_API_KEY to add web search on top.'}
          </p>
          <a href="/growth/ai" class="mt-2 inline-block text-sm" style="color: var(--color-brand-600)">See what it is costing →</a>
        </div>
      </div>
    </Card>

    <Card title="The agent" subtitle="How much it may look up, remember and teach itself">
      <div class="grid gap-3.5 sm:grid-cols-2">
        <div>
          <label for="agentBrowserMode" class="mb-1.5 block text-sm font-medium">Use a real browser</label>
          <select id="agentBrowserMode" name="agentBrowserMode" class="field">
            <option value="off" selected={settings.agentBrowserMode === 'off'}>Never — fetch pages only</option>
            <option value="fallback" selected={settings.agentBrowserMode === 'fallback'}>When a fetch comes back empty</option>
            <option value="always" selected={settings.agentBrowserMode === 'always'}>Always</option>
          </select>
          <p class="muted mt-1 text-xs leading-relaxed">
            A plain fetch sees the HTML the server sent, which on a site that draws itself with
            JavaScript is nothing at all — and a business with a decent site then gets assessed as
            having no content and emailed about a problem they do not have.
            {hasBrowser
              ? ' Browser Rendering is configured, so screenshots and rendered reads are available.'
              : ' Browser Rendering is not configured: set CLOUDFLARE_ACCOUNT_ID and a token carrying the Browser Rendering permission, or this setting does nothing.'}
          </p>
        </div>

        <div>
          <label for="agentStepBudget" class="mb-1.5 block text-sm font-medium">Tool calls per research task</label>
          <input id="agentStepBudget" name="agentStepBudget" type="number" min="1" max="24" value={settings.agentStepBudget} class="field max-w-28" />
          <p class="muted mt-1 text-xs leading-relaxed">
            The hard ceiling on searches and page loads in one task. When it is spent the agent
            answers from what it has and says what it could not establish. Research started by the
            pipeline gets a smaller budget than this.
          </p>
        </div>
      </div>

      <div class="mt-3.5 grid gap-3.5 sm:grid-cols-2">
        <div class="rounded-lg border p-3.5" style="border-color: var(--border)">
          <label class="flex items-center gap-2 text-sm font-medium">
            <input type="checkbox" name="agentMemoryEnabled" checked={settings.agentMemoryEnabled} />
            Remember things between runs
          </label>
          <p class="muted mt-2 text-xs leading-relaxed">
            Lessons, facts and preferences, scoped to a trade, a region or one business, recalled
            when they bear on the work in hand. Everything it remembers is readable and deletable
            on the <a href="/growth/memory" style="color: var(--color-brand-600)">memory page</a>.
          </p>
        </div>

        <div class="rounded-lg border p-3.5" style="border-color: var(--border)">
          <label class="flex items-center gap-2 text-sm font-medium">
            <input type="checkbox" name="agentSkillsEnabled" checked={settings.agentSkillsEnabled} />
            Load skills into the pipeline
          </label>
          <p class="muted mt-2 text-xs leading-relaxed">
            The <a href="/growth/skills" style="color: var(--color-brand-600)">skills you have written</a>
            are matched against each piece of work and the best few are loaded. Turning this off
            makes every run behave like the built-in prompts alone.
          </p>
        </div>
      </div>

      <div class="mt-3.5 grid gap-3.5 sm:grid-cols-2">
        <div>
          <label for="agentSelfImprove" class="mb-1.5 block text-sm font-medium">May it write its own skills?</label>
          <select id="agentSelfImprove" name="agentSelfImprove" class="field">
            <option value="off" selected={settings.agentSelfImprove === 'off'}>No</option>
            <option value="propose" selected={settings.agentSelfImprove === 'propose'}>It may propose; I approve</option>
            <option value="auto" selected={settings.agentSelfImprove === 'auto'}>Yes, and they take effect at once</option>
          </select>
          <p class="muted mt-1 text-xs leading-relaxed">
            At the end of a run it looks back at what happened and, occasionally, writes down a way
            of working it wants to keep. Every version is kept either way, so
            <strong style="color: var(--text)"> “yes” is reversible rather than reckless</strong> —
            and a skill that tries to talk the pipeline past the outreach cap or robots.txt is
            rejected whatever this says.
          </p>
        </div>

        <div>
          <label for="agentResearchDailyCap" class="mb-1.5 block text-sm font-medium">Unattended research tasks per day</label>
          <input id="agentResearchDailyCap" name="agentResearchDailyCap" type="number" min="0" max="200" value={settings.agentResearchDailyCap} class="field max-w-28" />
          <p class="muted mt-1 text-xs leading-relaxed">
            Research the pipeline starts on its own, in any rolling 24 hours. Zero stops it
            entirely; asking questions yourself is not capped until you are plainly running a loop.
          </p>
        </div>
      </div>
    </Card>

    <button class="rounded-lg px-4 py-2.5 text-sm font-medium text-white" style="background: var(--color-brand-600)">Save</button>
  </form>
</AppLayout>
