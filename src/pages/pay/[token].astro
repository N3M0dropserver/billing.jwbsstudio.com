---
/**
 * Public invoice view. No session required — the token IS the credential,
 * so it must be long, random, and never guessable. Nothing on this page
 * exposes anything beyond the single invoice it belongs to.
 */
import '~/styles/app.css';
import { eq } from 'drizzle-orm';
import { db, appUrl, bindings } from '~/lib/env';
import { getInvoiceByToken } from '~/lib/invoices/service';
import { getSettings } from '~/lib/queries/settings';
import { deriveStatus } from '~/lib/invoices/calculate';
import { invoices } from '~/lib/db/schema';
import { formatMoneyWithCode } from '~/lib/tax/money';
import { stripeEnabled } from '~/lib/stripe';
import { isNewOccurrence, recordInvoiceEvent } from '~/lib/activity/events';
import { lastEventAt } from '~/lib/activity/timeline';

const token = Astro.params.token!;
const database = db();
const invoice = await getInvoiceByToken(database, token);

if (!invoice) {
  return new Response('Invoice not found', { status: 404 });
}

const settings = await getSettings(database, invoice.userId);
const status = deriveStatus(invoice);
const outstanding = invoice.total - invoice.amountPaid;

/*
 * Record the view.
 *
 * `invoices.viewedAt` keeps the first view only, because that is what the
 * status badge is derived from. Every later visit goes to the activity log
 * instead, where "they have opened this four times and still not paid" is
 * worth knowing. Both are best effort — a client must never see an error
 * page because a log write failed.
 */
try {
  const now = new Date().toISOString();

  if (!invoice.viewedAt) {
    await database.update(invoices).set({ viewedAt: now }).where(eq(invoices.id, invoice.id));
  }

  const previous = await lastEventAt(database, invoice.id, 'viewed');
  if (isNewOccurrence(previous, now)) {
    await recordInvoiceEvent(database, {
      invoiceId: invoice.id,
      clientId: invoice.clientId,
      type: 'viewed',
      actor: 'client',
      detail: { first: !invoice.viewedAt },
      ipAddress: Astro.request.headers.get('cf-connecting-ip'),
      userAgent: Astro.request.headers.get('user-agent'),
      occurredAt: now,
    });
  }
} catch (error) {
  console.error(`[activity] could not record a view of ${invoice.number}: ${String(error)}`);
}

const canPayByCard =
  settings.stripeEnabled && stripeEnabled(bindings()) && outstanding > 0;

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-NZ', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });

const gstLabel =
  invoice.gstTreatment === 'standard'
    ? invoice.jurisdiction === 'NZ' ? 'GST 15%' : 'GST 10%'
    : invoice.gstTreatment === 'zero-rated-export'
      ? invoice.jurisdiction === 'NZ' ? 'Zero-rated export' : 'GST-free export'
      : 'No GST';

const bankRows = [
  ['Account name', settings.bankAccountName],
  ['Account number', settings.bankAccountNumber],
  ['BSB', settings.bankBsb],
  ['Bank', settings.bankName],
  ['SWIFT', settings.bankSwift],
  ['Reference', invoice.number],
].filter(([, value]) => value);
---

<!doctype html>
<html lang="en-NZ" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Invoice {invoice.number} · {settings.businessName}</title>
  </head>
  <body class="px-4 py-10">
    <main class="mx-auto w-full max-w-2xl">
      <div class="card p-6 sm:p-8">
        <header class="mb-8 flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-lg font-semibold" style="color: var(--color-brand-600)">
              {settings.businessName}
            </p>
            <p class="muted mt-0.5 text-sm">{settings.email}</p>
          </div>
          <div class="text-right">
            <p class="text-sm font-semibold tracking-wide">
              {invoice.gstTreatment === 'not-registered' ? 'INVOICE' : 'TAX INVOICE'}
            </p>
            <p class="muted text-sm">{invoice.number}</p>
          </div>
        </header>

        <div class="mb-8 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="muted mb-1.5 text-xs font-medium uppercase tracking-wide">Bill to</p>
            <p class="font-medium">{invoice.client?.name}</p>
            {invoice.client?.addressLine1 && <p class="muted text-sm">{invoice.client.addressLine1}</p>}
            {invoice.client?.city && <p class="muted text-sm">{invoice.client.city}</p>}
          </div>
          <div>
            <p class="muted mb-1.5 text-xs font-medium uppercase tracking-wide">Details</p>
            <p class="text-sm"><span class="muted">Issued</span> {formatDate(invoice.issuedOn)}</p>
            <p class="text-sm"><span class="muted">Due</span> {formatDate(invoice.dueOn)}</p>
            {invoice.reference && <p class="text-sm"><span class="muted">Ref</span> {invoice.reference}</p>}
          </div>
        </div>

        {status === 'paid' ? (
          <div
            class="mb-8 rounded-lg px-4 py-3 text-center text-sm font-medium"
            style="background: color-mix(in oklch, var(--color-paid) 14%, transparent); color: var(--color-paid)"
          >
            Paid in full — thank you.
          </div>
        ) : (
          <div class="mb-8 rounded-lg px-4 py-5 text-center" style="background: var(--surface-sunken)">
            <p class="muted text-xs font-medium uppercase tracking-wide">Amount due</p>
            <p class="tabular mt-1 text-3xl font-semibold">
              {formatMoneyWithCode(outstanding, invoice.currency)}
            </p>
            <p class="muted mt-1 text-sm">by {formatDate(invoice.dueOn)}</p>
          </div>
        )}

        <table class="w-full text-sm">
          <thead>
            <tr class="muted border-b text-left text-xs" style="border-color: var(--border)">
              <th scope="col" class="py-2 font-medium">Description</th>
              <th scope="col" class="py-2 text-right font-medium">Qty</th>
              <th scope="col" class="py-2 text-right font-medium">Amount</th>
            </tr>
          </thead>
          <tbody>
            {invoice.lines.map((line) => (
              <tr class="border-b last:border-0" style="border-color: var(--border)">
                <td class="py-2.5 pr-3">{line.description}</td>
                <td class="tabular muted py-2.5 text-right whitespace-nowrap">
                  {(line.quantity / 1000).toFixed(2).replace(/\.00$/, '')} {line.unit}
                </td>
                <td class="tabular py-2.5 text-right">{formatMoneyWithCode(line.lineTotal, invoice.currency)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <dl class="mt-4 ml-auto max-w-xs space-y-1.5 text-sm">
          <div class="flex justify-between gap-3">
            <dt class="muted">Subtotal</dt>
            <dd class="tabular">{formatMoneyWithCode(invoice.subtotal, invoice.currency)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="muted">{gstLabel}</dt>
            <dd class="tabular">{formatMoneyWithCode(invoice.gstAmount, invoice.currency)}</dd>
          </div>
          <div class="flex justify-between gap-3 border-t pt-1.5 text-base font-semibold" style="border-color: var(--border)">
            <dt>Total</dt>
            <dd class="tabular">{formatMoneyWithCode(invoice.total, invoice.currency)}</dd>
          </div>
        </dl>

        {outstanding > 0 && (
          <div class="mt-8 border-t pt-6" style="border-color: var(--border)">
            <p class="muted mb-3 text-xs font-medium uppercase tracking-wide">How to pay</p>

            {canPayByCard && (
              <form method="post" action={`/api/stripe/checkout`} class="mb-5">
                <input type="hidden" name="token" value={token} />
                <button
                  class="w-full rounded-lg px-4 py-3 text-sm font-medium text-white"
                  style="background: var(--color-brand-600)"
                >
                  Pay {formatMoneyWithCode(outstanding, invoice.currency)} by card
                </button>
              </form>
            )}

            <dl class="grid gap-1.5 text-sm sm:grid-cols-[10rem_1fr]">
              {bankRows.map(([label, value]) => (
                <>
                  <dt class="muted">{label}</dt>
                  <dd class="tabular">{value}</dd>
                </>
              ))}
            </dl>
          </div>
        )}

        {invoice.notes && (
          <p class="muted mt-6 border-t pt-5 text-sm" style="border-color: var(--border)">{invoice.notes}</p>
        )}

        <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t pt-5" style="border-color: var(--border)">
          <p class="muted text-xs">{settings.invoiceFooter || settings.businessName}</p>
          <a
            href={`${appUrl()}/pay/${token}/pdf`}
            class="muted rounded-md border px-3 py-1.5 text-xs hover:opacity-80"
            style="border-color: var(--border)"
          >Download PDF</a>
        </div>
      </div>
    </main>
  </body>
</html>
