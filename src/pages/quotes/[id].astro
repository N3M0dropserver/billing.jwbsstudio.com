---
import AppLayout from '~/layouts/AppLayout.astro';
import Card from '~/components/ui/Card.astro';
import { db, appUrl } from '~/lib/env';
import { getQuote, hasLapsed } from '~/lib/quotes/service';
import { formatMoneyWithCode } from '~/lib/tax/money';

const user = Astro.locals.user!;
const database = db();
const quote = await getQuote(database, user.id, Astro.params.id!);

if (!quote) return Astro.redirect('/quotes', 302);

const lapsed = hasLapsed(quote);
const publicUrl = quote.publicToken ? `${appUrl()}/proposal/${quote.publicToken}` : null;

const q = Astro.url.searchParams;
const sent = q.get('sent');
const reason = q.get('reason');
const error = q.get('error');

const gstLabel =
  quote.gstTreatment === 'standard'
    ? quote.jurisdiction === 'NZ' ? 'GST 15%' : 'GST 10%'
    : quote.gstTreatment === 'zero-rated-export'
      ? quote.jurisdiction === 'NZ' ? 'Zero-rated export' : 'GST-free export'
      : 'No GST';

const status = quote.convertedInvoiceId
  ? 'invoiced'
  : lapsed && quote.status !== 'accepted' && quote.status !== 'declined'
    ? 'expired'
    : quote.status;

const formatDate = (iso: string) =>
  new Date(`${iso.slice(0, 10)}T00:00:00Z`).toLocaleDateString('en-NZ', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });
---

<AppLayout title={quote.number} subtitle={quote.title} width="wide">
  <div slot="actions" class="flex flex-wrap gap-2">
    {publicUrl && (
      <a href={publicUrl} target="_blank" rel="noopener" class="muted card px-3.5 py-2 text-sm font-medium hover:opacity-80">
        Client view
      </a>
    )}
    {quote.convertedInvoiceId && (
      <a
        href={`/invoices/${quote.convertedInvoiceId}`}
        class="btn btn-primary"
      >Go to the invoice</a>
    )}
  </div>

  {error && <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-overdue)">{error}</p>}
  {sent === 'ok' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-paid)">Quote emailed.</p>
  )}
  {sent === 'failed' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-overdue)">Could not send: {reason}</p>
  )}
  {sent === 'no-email' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-overdue)">
      No email address on file for this client.
    </p>
  )}

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <Card>
        <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="muted mb-1 text-xs font-medium uppercase tracking-wide">{status}</p>
            <p class="muted text-sm">
              {quote.client?.name ?? 'No client yet'}
              {quote.expiresOn && ` · holds until ${formatDate(quote.expiresOn)}`}
            </p>
          </div>
          <p class="tabular text-2xl font-semibold">
            {formatMoneyWithCode(quote.total, quote.currency)}
          </p>
        </div>

        {quote.body && (
          <p class="mb-5 border-b pb-5 text-sm leading-relaxed whitespace-pre-wrap" style="border-color: var(--border)">
            {quote.body}
          </p>
        )}

        <table class="w-full text-sm">
          <tbody>
            {quote.lines.map((line) => (
              <tr class="border-b last:border-0" style="border-color: var(--border)">
                <td class="py-2.5 pr-3">{line.description}</td>
                <td class="tabular muted py-2.5 text-right whitespace-nowrap">
                  {(line.quantity / 1000).toFixed(2).replace(/\.00$/, '')} {line.unit}
                </td>
                <td class="tabular py-2.5 pl-3 text-right">
                  {formatMoneyWithCode(line.lineTotal, quote.currency)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <dl class="mt-4 ml-auto max-w-xs space-y-1.5 text-sm">
          <div class="flex justify-between gap-3">
            <dt class="muted">Subtotal</dt>
            <dd class="tabular">{formatMoneyWithCode(quote.subtotal, quote.currency)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="muted">{gstLabel}</dt>
            <dd class="tabular">{formatMoneyWithCode(quote.gstAmount, quote.currency)}</dd>
          </div>
        </dl>
      </Card>

      {quote.status === 'accepted' && (
        <Card title="Accepted">
          <p class="text-sm">
            {quote.acceptedName
              ? `${quote.acceptedName} accepted this quote`
              : 'This quote was accepted'}
            {quote.respondedAt && ` on ${formatDate(quote.respondedAt)}`}.
          </p>
          <p class="muted mt-1.5 text-xs">
            Recorded from {quote.acceptedIp ?? 'an unknown address'}. This is the agreement the
            invoice rests on, so it is kept with the quote.
          </p>
        </Card>
      )}

      {quote.status === 'declined' && (
        <Card title="Declined">
          <p class="text-sm">
            Declined{quote.respondedAt && ` on ${formatDate(quote.respondedAt)}`}.
          </p>
          {quote.declineReason && (
            <p class="muted mt-1.5 text-sm">“{quote.declineReason}”</p>
          )}
        </Card>
      )}
    </div>

    <div class="space-y-4">
      {quote.status === 'accepted' && !quote.convertedInvoiceId && (
        <Card title="Raise the invoice" subtitle="Copies these lines exactly as agreed">
          <form method="post" action={`/api/quotes/${quote.id}/convert`}>
            <p class="muted mb-3 text-xs leading-relaxed">
              The lines are copied as they were priced, not recalculated — so the invoice says
              what the client agreed to even if a rate has changed since. It is created as a
              draft, with an invoice number and payment terms from this client.
            </p>
            <button
              class="btn btn-primary w-full"
            >Create invoice</button>
          </form>
        </Card>
      )}

      {!quote.convertedInvoiceId && quote.status !== 'declined' && (
        <Card title={quote.sentAt ? 'Send again' : 'Send to client'}>
          <form method="post" action={`/api/quotes/${quote.id}/send`} class="space-y-3">
            <div>
              <label for="to" class="muted mb-1 block text-xs font-medium">To</label>
              <input id="to" name="to" type="email" value={quote.client?.email ?? ''} required class="field" />
            </div>
            <div>
              <label for="message" class="muted mb-1 block text-xs font-medium">Message (optional)</label>
              <textarea id="message" name="message" rows="3" class="field" placeholder="Leave blank for the standard wording"></textarea>
            </div>
            <button
              class="btn btn-primary w-full"
            >{quote.sentAt ? 'Send again' : 'Send quote'}</button>
            {quote.sentAt && (
              <p class="muted text-xs">
                Sent {formatDate(quote.sentAt)}
                {quote.viewedAt && ` · opened ${formatDate(quote.viewedAt)}`}
              </p>
            )}
          </form>
        </Card>
      )}

      {publicUrl && quote.status !== 'draft' && (
        <Card title="Client link" subtitle="Anyone with this link can read and accept">
          <input readonly value={publicUrl} class="field text-xs" onclick="this.select()" />
        </Card>
      )}

      <Card title="Document">
        <a
          href={`${appUrl()}/proposal/${quote.publicToken}/pdf`}
          target="_blank" rel="noopener"
          class="muted block rounded-md border px-2 py-1.5 text-center text-xs hover:opacity-80"
          style="border-color: var(--border)"
        >Download PDF</a>
      </Card>
    </div>
  </div>
</AppLayout>
