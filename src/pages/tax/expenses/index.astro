---
import AppLayout from '~/layouts/AppLayout.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import { and, eq, gte, lte, desc } from 'drizzle-orm';
import { db } from '~/lib/env';
import { getSettings } from '~/lib/queries/settings';
import { currentTaxYear } from '~/lib/queries/dashboard';
import { expenses, clients } from '~/lib/db/schema';
import { formatMoney } from '~/lib/tax/money';
import { EXPENSE_GUIDANCE } from '~/lib/tax/deductions';

const user = Astro.locals.user!;
const database = db();
const settings = await getSettings(database, user.id);
const range = currentTaxYear(settings.taxResidence);

const rows = await database
  .select({ expense: expenses, clientName: clients.name })
  .from(expenses)
  .leftJoin(clients, eq(expenses.clientId, clients.id))
  .where(
    and(
      eq(expenses.userId, user.id),
      gte(expenses.incurredOn, range.startsOn),
      lte(expenses.incurredOn, range.endsOn),
    ),
  )
  .orderBy(desc(expenses.incurredOn))
  .limit(500);

const totals = rows.reduce(
  (acc, row) => {
    acc.gross += row.expense.amountGross;
    acc.claimable += row.expense.claimableAmount;
    acc.gst += Math.round(row.expense.gstAmount * row.expense.businessUsePercent);
    return acc;
  },
  { gross: 0, claimable: 0, gst: 0 },
);

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-NZ', {
    day: 'numeric', month: 'short', year: '2-digit', timeZone: 'UTC',
  });
---

<AppLayout
  title="Expenses"
  subtitle={`${range.year} · ${formatMoney(totals.claimable, settings.defaultCurrency)} claimable`}
  width="wide"
>
  <a slot="actions" href="/tax/expenses/new" class="btn btn-primary">Log expense</a>

  {Astro.url.searchParams.get('added') === '1' && (
    <p class="card mb-4 px-4 py-3 text-sm" style="color: var(--color-paid)">Expense recorded.</p>
  )}

  {
    rows.length === 0 ? (
      <EmptyState
        title="No expenses recorded this year"
        description="Software, hardware, home office, travel, subcontractors — all of it reduces what you pay."
        actionHref="/tax/expenses/new"
        actionLabel="Log your first expense"
      />
    ) : (
      <>
        {/* Phones: description leads, the claimable figure is the number that matters. */}
        <div class="card divide-y overflow-hidden lg:hidden" style="border-color: var(--border)">
          {rows.map(({ expense, clientName }) => (
            <div class="px-4 py-3.5" style="border-color: var(--border)">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-sm font-medium">{expense.description}</p>
                  <p class="muted mt-0.5 truncate text-xs">
                    {[expense.vendor, clientName].filter(Boolean).join(' · ') ||
                      EXPENSE_GUIDANCE[expense.category as keyof typeof EXPENSE_GUIDANCE]?.label ||
                      expense.category}
                  </p>
                </div>
                <span class="label-xs muted shrink-0">{formatDate(expense.incurredOn)}</span>
              </div>
              <div class="mt-2.5 flex items-baseline justify-between gap-3">
                <span class="label-xs muted">
                  {formatMoney(expense.amountGross, expense.currency)} paid ·{' '}
                  {Math.round(expense.businessUsePercent * 100)}% business
                </span>
                <span class="tabular text-sm font-semibold">
                  {expense.isCapital
                    ? 'Depreciated'
                    : formatMoney(expense.claimableAmount, expense.currency)}
                </span>
              </div>
            </div>
          ))}
          <div class="flex items-baseline justify-between gap-3 px-4 py-3" style="background: var(--surface-sunken); border-color: var(--border)">
            <span class="label muted">{rows.length} claimable</span>
            <span class="tabular text-sm font-semibold">{formatMoney(totals.claimable, settings.defaultCurrency)}</span>
          </div>
        </div>

        {/* Desktop: the full grid. */}
        <div class="card hidden overflow-hidden lg:block">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left" style="border-color: var(--border)">
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Date</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Description</th>
                <th scope="col" class="label muted px-4 py-2.5 font-medium">Category</th>
                <th scope="col" class="label muted px-4 py-2.5 text-right font-medium">Paid</th>
                <th scope="col" class="label muted px-4 py-2.5 text-right font-medium">Use</th>
                <th scope="col" class="label muted px-4 py-2.5 text-right font-medium">Claimable</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(({ expense, clientName }) => (
                <tr class="border-b last:border-0" style="border-color: var(--border)">
                  <td class="tabular muted px-4 py-2.5 whitespace-nowrap">{formatDate(expense.incurredOn)}</td>
                  <td class="px-4 py-2.5">
                    {expense.description}
                    {expense.vendor && <span class="muted"> · {expense.vendor}</span>}
                    {clientName && <span class="muted"> · {clientName}</span>}
                    {expense.isCapital && <span class="label-xs muted ml-1.5">capital</span>}
                    {expense.receiptKey && (
                      <a
                        href={`/api/expenses/${expense.id}/receipt`}
                        target="_blank" rel="noopener"
                        class="label-xs ml-1.5 underline"
                        style="color: var(--accent-text)"
                        title="The receipt as photographed"
                      >receipt</a>
                    )}
                  </td>
                  <td class="muted px-4 py-2.5">
                    {EXPENSE_GUIDANCE[expense.category as keyof typeof EXPENSE_GUIDANCE]?.label ?? expense.category}
                  </td>
                  <td class="tabular px-4 py-2.5 text-right">{formatMoney(expense.amountGross, expense.currency)}</td>
                  <td class="tabular muted px-4 py-2.5 text-right">{Math.round(expense.businessUsePercent * 100)}%</td>
                  <td class="tabular px-4 py-2.5 text-right font-medium">
                    {expense.isCapital ? (
                      <span class="muted">depreciated</span>
                    ) : (
                      formatMoney(expense.claimableAmount, expense.currency)
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-t" style="border-color: var(--border); background: var(--surface-sunken)">
                <td class="label muted px-4 py-2.5" colspan="3">
                  {rows.length} expenses
                  {totals.gst > 0 && (
                    <span> · {formatMoney(totals.gst, settings.defaultCurrency)} GST reclaimable</span>
                  )}
                </td>
                <td class="tabular px-4 py-2.5 text-right font-medium">{formatMoney(totals.gross, settings.defaultCurrency)}</td>
                <td></td>
                <td class="tabular px-4 py-2.5 text-right font-medium">{formatMoney(totals.claimable, settings.defaultCurrency)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </>
    )
  }
</AppLayout>
