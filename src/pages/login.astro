---
import '~/styles/app.css';

const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent') === '1';
const next = Astro.url.searchParams.get('next') ?? '/';

/**
 * Password failures share one message on purpose — the server log says which
 * it actually was. Link failures are named, because by the time you are
 * holding a link you have already proved you can read the mailbox, and
 * "expired" versus "already used" is the difference between asking for
 * another one and realising something else opened it first.
 */
const messages: Record<string, string> = {
  invalid: 'That email and password combination was not recognised.',
  locked: 'Too many failed attempts. Try again in 15 minutes, or use a sign-in link.',
  disabled: 'That account has been disabled.',
  expired: 'Your session expired. Sign in again.',
  'missing-fields': 'Fill in both fields.',
  'stale-hash':
    'Your stored password cannot be checked on this server. Use a sign-in link below — it will get you in, and you can set a new password from there.',
  'link-expired': 'That sign-in link has expired. Ask for a new one.',
  'link-used': 'That sign-in link has already been used. Ask for a new one.',
  'link-unknown': 'That sign-in link is not valid. Ask for a new one.',
  'account-disabled': 'That account has been disabled.',
};
---

<!doctype html>
<html lang="en-NZ" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in · JWBS Studio</title>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored) document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body class="grid h-full place-items-center px-4 py-8">
    <main class="w-full max-w-sm">
      <div class="mb-8 flex flex-col items-center gap-3">
        <span
          class="grid size-11 place-items-center text-lg font-bold"
          style="background: var(--accent); color: var(--accent-ink); border-radius: 2px"
        >J</span>
        <div class="text-center">
          <h1 class="text-lg font-semibold tracking-tight">JWBS Studio</h1>
          <p class="label muted mt-1">Invoicing, billing and tax</p>
        </div>
      </div>

      {
        sent && (
          <div
            class="mb-4 border px-3.5 py-3 text-sm leading-relaxed"
            style="border-color: color-mix(in oklch, var(--color-paid) 45%, transparent); background: color-mix(in oklch, var(--color-paid) 10%, transparent); color: var(--color-paid); border-radius: var(--radius-ctl)"
            role="status"
          >
            If that address has an account, a sign-in link is on its way. It
            works once and expires in 15 minutes.
          </div>
        )
      }

      {
        error && (
          <div
            class="mb-4 border px-3.5 py-3 text-sm leading-relaxed"
            style="border-color: color-mix(in oklch, var(--color-overdue) 45%, transparent); background: color-mix(in oklch, var(--color-overdue) 10%, transparent); color: var(--color-overdue); border-radius: var(--radius-ctl)"
            role="alert"
          >
            {messages[error] ?? 'Something went wrong. Try again.'}
          </div>
        )
      }

      <form method="post" action="/api/auth/login" class="card space-y-4 p-5 sm:p-6">
        <input type="hidden" name="next" value={next} />

        <div>
          <label for="email" class="label muted mb-1.5 block">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="username"
            autofocus
            class="field"
          />
        </div>

        <div>
          <label for="password" class="label muted mb-1.5 block">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="field"
          />
        </div>

        <button
          type="submit"
          class="btn btn-primary w-full"
        >
          Sign in
        </button>
      </form>

      <div class="my-5 flex items-center gap-3">
        <span class="h-px flex-1" style="background: var(--border)"></span>
        <span class="label muted">or</span>
        <span class="h-px flex-1" style="background: var(--border)"></span>
      </div>

      <form method="post" action="/api/auth/magic-link" class="card space-y-4 p-5 sm:p-6">
        <input type="hidden" name="next" value={next} />

        <div>
          <label for="magic-email" class="label muted mb-1.5 block">
            Email me a sign-in link
          </label>
          <input
            id="magic-email"
            name="email"
            type="email"
            required
            autocomplete="username"
            placeholder="you@example.com"
            class="field"
          />
          <p class="muted mt-1.5 text-xs">
            No password needed. The link works once and expires in 15 minutes.
          </p>
        </div>

        <button type="submit" class="btn btn-secondary w-full">Send sign-in link</button>
      </form>

      <p class="muted mt-5 text-center text-xs">
        Accounts are created by the administrator. There is no sign-up.
      </p>
    </main>
  </body>
</html>
